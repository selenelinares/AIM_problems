% *****************************************************************
% AIM:  x * y = y * x => 
%
%    L(x,y,(x \ z) * (z \ x)) = x # label("L3 reciprocal").
% *****************************************************************

% The LADR formulas contain function or predicate symbols
% that are not legal TPTP symbols, and we have replaced those
% symbols with new symbols.  Here is the list of the unaccepted
% symbols and the corresponding replacements.
%
%   (arity 2)        \    '\\'
%   (arity 2)        *    '*'
%   (arity 3)        L    'L'
%   (arity 2)        /    '/'
%   (arity 2)        T    'T'
%   (arity 0)        1    '1'
%   (arity 2)        K    'K'
%   (arity 3)        R    'R'

cnf(sos,axiom,'*'('1',A) = A).
cnf(sos,axiom,'*'(A,'1') = A).
cnf(sos,axiom,'\\'(A,'*'(A,B)) = B).
cnf(sos,axiom,'*'(A,'\\'(A,B)) = B).
cnf(sos,axiom,'/'('*'(A,B),B) = A).
cnf(sos,axiom,'*'('/'(A,B),B) = A).
cnf(sos,axiom,'\\'('*'(A,'*'(B,C)),'*'('*'(A,B),C)) = a(A,B,C)).
cnf(sos,axiom,'\\'('*'(A,B),'*'(B,A)) ='K'(B,A)).
cnf(sos,axiom,'\\'('*'(A,B),'*'(A,'*'(B,C))) ='L'(C,B,A)).
cnf(sos,axiom,'/'('*'('*'(A,B),C),'*'(B,C)) ='R'(A,B,C)).
cnf(sos,axiom,'\\'(A,'*'(B,A)) ='T'(B,A)).
cnf(sos,axiom,'T'('T'(A,B),C) ='T'('T'(A,C),B)).
cnf(sos,axiom,'T'('L'(A,B,C),D) ='L'('T'(A,D),B,C)).
cnf(sos,axiom,'T'('R'(A,B,C),D) ='R'('T'(A,D),B,C)).
cnf(sos,axiom,'L'('R'(A,B,C),D,E) ='R'('L'(A,D,E),B,C)).
cnf(sos,axiom,'L'('L'(A,B,C),D,E) ='L'('L'(A,D,E),B,C)).
cnf(sos,axiom,'R'('R'(A,B,C),D,E) ='R'('R'(A,D,E),B,C)).
cnf(sos,axiom,'*'(A,B) = '*'(B,A)).
cnf(sos,axiom, '*'(A,B) != C | '*'(A,D) != C | B = D).
cnf(sos,axiom, '*'(A,B) != C | '*'(D,B) != C | A = D).
cnf(sos,axiom, '/'(A,B) != C | '/'(A,D) != C | B = D).
cnf(sos,axiom, '/'(A,B) != C | '/'(D,B) != C | A = D).
cnf(sos,axiom, '\\'(A,B) != C | '\\'(A,D) != C | B = D).
cnf(sos,axiom, '\\'(A,B) != C | '\\'(D,B) != C | A = D).
cnf(sos,axiom, 'T'(A,B) != C | 'T'(D,B) != C | A = D).
cnf(sos,axiom, 'L'(A,B,C) != D | 'L'(E,B,C) != D | A = E).
cnf(sos,axiom, 'R'(A,B,C) != D | 'R'(E,B,C) != D | A = E).
cnf(sos,axiom, '*'(A,B) != '*'(A,C) | B = C).
cnf(sos,axiom, '*'(A,B) != '*'(C,B) | A = C).
cnf(sos,axiom, '/'(A,B) != '/'(A,C) | B = C).
cnf(sos,axiom, '/'(A,B) != '/'(C,B) | A = C).
cnf(sos,axiom, '\\'(A,B) != '\\'(A,C) | B = C).
cnf(sos,axiom, '\\'(A,B) != '\\'(C,B) | A = C).
cnf(sos,axiom, 'T'(A,B) !='T'(C,B) | A = C).
cnf(sos,axiom, 'L'(A,B,C) !='L'(D,B,C) | A = D).
cnf(sos,axiom, 'R'(A,B,C) !='R'(D,B,C) | A = D).
cnf(sos,axiom, a(A,B,C) !='1' |'L'(C,B,A) = C).
cnf(sos,axiom, 'L'(A,B,C) != A | a(C,B,A) ='1').
cnf(sos,axiom, 'T'(A,B) != A |'T'(B,A) = B).
cnf(sos,axiom, 'T'(A,B) != A |'K'(A,B) ='1').
cnf(sos,axiom, 'K'(A,B) !='1' |'T'(A,B) = A).
cnf(sos,axiom, A != B | '*'(A,C) = '*'(B,C)).
cnf(sos,axiom, A != B | '*'(C,A) = '*'(C,B)).
cnf(sos,axiom, A != B | '/'(A,C) = '/'(B,C)).
cnf(sos,axiom, A != B | '/'(C,A) = '/'(C,B)).
cnf(sos,axiom, A != B | '\\'(A,C) = '\\'(B,C)).
cnf(sos,axiom, A != B | '\\'(C,A) = '\\'(C,B)).
cnf(sos,axiom, A != B |  B != C | A = C).
fof(goals,conjecture,! [X0] : ! [X1] : ! [X2] :'L'(X0,X1,'*'('\\'(X0,X2),'\\'(X2,X0))) = X0).


%%
% The following clauses correspond to the original list of hints
% Watchlist taken from recipL3-only_original_hints.tptp
%%


cnf(sos,watchlist,'L'(A,B,'*'('\\'(A,C),'\\'(C,A))) = A).
cnf(sos,watchlist,'*'(A,B) = '*'(B,A)).
cnf(sos,watchlist,'*'('1',A) = A).
cnf(sos,watchlist,'*'(A,'1') = A).
cnf(sos,watchlist,'\\'(A,'*'(A,B)) = B).
cnf(sos,watchlist,'*'(A,'\\'(A,B)) = B).
cnf(sos,watchlist,'*'('/'(A,B),B) = A).
cnf(sos,watchlist,'\\'('*'(A,'*'(B,C)),'*'('*'(A,B),C)) = a(A,B,C)).
cnf(sos,watchlist,'\\'('*'(A,B),'*'(A,'*'(B,C))) ='L'(C,B,A)).
cnf(sos,watchlist,'\\'(A,'*'(B,A)) ='T'(B,A)).
cnf(sos,watchlist,'L'('L'(A,B,C),D,E) ='L'('L'(A,D,E),B,C)).
cnf(sos,watchlist,'K'(A,'K'(B,'*'(C,C))) ='1').
cnf(sos,watchlist,a(A,'K'(A,B),C) ='1').
cnf(sos,watchlist,a(A,B,'K'(A,C)) ='1').
cnf(sos,watchlist,~ '*'(A,B) = C | ~ '*'(A,D) = C | B = D ).
cnf(sos,watchlist,~ '*'(A,B) = C | ~ '*'(D,B) = C | A = D ).
cnf(sos,watchlist,~ '/'(A,B) = C | ~ '/'(A,D) = C | B = D ).
cnf(sos,watchlist,~ '\\'(A,B) = C | ~ '\\'(A,D) = C | B = D ).
cnf(sos,watchlist,~ '\\'(A,B) = C | ~ '\\'(D,B) = C | A = D ).
cnf(sos,watchlist,~'T'(A,B) = C | ~'T'(D,B) = C | A = D ).
cnf(sos,watchlist,~'L'(A,B,C) = D | ~'L'(E,B,C) = D | A = E ).
cnf(sos,watchlist,~ '*'(A,B) = '*'(A,C) | B = C).
cnf(sos,watchlist,~ '*'(A,B) = '*'(C,B) | A = C).
cnf(sos,watchlist,~ '\\'(A,B) = '\\'(A,C) | B = C).
cnf(sos,watchlist,~ '\\'(A,B) = '\\'(C,B) | A = C).
cnf(sos,watchlist,~'L'(A,B,C) ='L'(D,B,C) | A = D).
cnf(sos,watchlist,~ a(A,B,C) ='1' |'L'(C,B,A) = C).
cnf(sos,watchlist,~'L'(A,B,C) = A | a(C,B,A) ='1').
cnf(sos,watchlist,~ A = B | '*'(C,A) = '*'(C,B)).
cnf(sos,watchlist,~ A = B | ~ B = C | A = C ).
cnf(sos,watchlist,'*'('K'(A,B),'*'(B,A)) = '*'(A,B)).
cnf(sos,watchlist,'/'('*'('*'(A,B),C),'R'(A,B,C)) = '*'('*'(B,C),'K'('L'(A,B,C),'*'(B,C)))).
cnf(sos,watchlist,~'L'(c1,c2,'*'('\\'(c1,c3),'\\'(c3,c1))) = c1).
cnf(sos,watchlist,'*'('1','*'(A,B)) = '*'(B,A)).
cnf(sos,watchlist,'\\'(A,'*'(B,A)) = B).
cnf(sos,watchlist,'\\'('1',A) = A).
cnf(sos,watchlist,'\\'(A,A) ='1').
cnf(sos,watchlist,A = '*'('\\'(B,A),B)).
cnf(sos,watchlist,'*'('\\'(A,B),A) = B).
cnf(sos,watchlist,'\\'('*'(A,'*'(B,C)),'*'(C,'*'(A,B))) = a(A,B,C)).
cnf(sos,watchlist,'\\'('*'(A,B),'*'('*'(A,C),'\\'(C,B))) = a(A,C,'\\'(C,B))).
cnf(sos,watchlist,'\\'('*'(A,B),'*'(B,'*'(A,C))) ='L'(C,A,B)).
cnf(sos,watchlist,'\\'('*'(A,B),'*'(A,'*'(C,B))) ='L'(C,B,A)).
cnf(sos,watchlist,'\\'('*'(A,B),'*'(A,C)) ='L'('\\'(B,C),B,A)).
cnf(sos,watchlist,'L'('\\'(A,B),A,C) = '\\'('*'(C,A),'*'(C,B))).
cnf(sos,watchlist,a(A,'1',B) ='1').
cnf(sos,watchlist,a(A,B,'1') ='1').
cnf(sos,watchlist,~ '*'(A,B) = C | ~ '*'(B,D) = C | A = D ).
cnf(sos,watchlist,~ A = B | ~ '*'(C,D) = B | '\\'(C,A) = D ).
cnf(sos,watchlist,~ A = B | ~ '\\'(C,D) = B | '*'(C,A) = D ).
cnf(sos,watchlist,~ A = '*'('1',B) | A = B).
cnf(sos,watchlist,~ '*'('1',A) = B | B = A).
cnf(sos,watchlist,~ A = '*'(B,C) | '\\'(B,A) = C).
cnf(sos,watchlist,~ '*'(A,B) = C | '\\'(A,C) = B).
cnf(sos,watchlist,~ A = '\\'(B,C) | '*'(B,A) = C).
cnf(sos,watchlist,~ '\\'(A,B) = C | '*'(A,C) = B).
cnf(sos,watchlist,'*'(A,'*'(B,C)) = '*'(A,'*'(C,B))).
cnf(sos,watchlist,'/'('*'(A,'*'(B,C)),'R'(B,C,A)) = '*'('*'(C,A),'K'('L'(B,C,A),'*'(C,A)))).
cnf(sos,watchlist,~ '\\'(A,'*'(B,A)) = C |'T'(B,A) = C).
cnf(sos,watchlist,'T'(A,B) = A).
cnf(sos,watchlist,'\\'('\\'(A,B),B) = A).
cnf(sos,watchlist,'\\'(A,B) = '/'(B,A)).
cnf(sos,watchlist,'/'(A,B) = '\\'(B,A)).
cnf(sos,watchlist,~ A = B | ~ '\\'(C,D) = B | '*'(A,C) = D ).
cnf(sos,watchlist,~ A = '\\'(B,C) | '*'(A,B) = C).
cnf(sos,watchlist,~ '\\'(A,B) = C | '*'(C,A) = B).
cnf(sos,watchlist,~ '\\'(A,'*'(B,A)) = C | B = C).
cnf(sos,watchlist,A ='L'(A,B,A)).
cnf(sos,watchlist,'L'(A,B,A) = A).
cnf(sos,watchlist,~'L'(A,B,C) = D | '\\'('*'(B,C),'*'(C,'*'(B,A))) = D).
cnf(sos,watchlist,'\\'('*'(A,B),'*'(B,'*'(A,C))) = '*'('1','L'(C,A,B))).
cnf(sos,watchlist,'\\'('*'(A,B),'*'(B,'*'(C,A))) ='L'(C,A,B)).
cnf(sos,watchlist,'\\'(A,'*'('\\'(B,A),'*'(B,C))) ='L'(C,B,'\\'(B,A))).
cnf(sos,watchlist,'\\'('*'(A,B),'*'(B,C)) ='L'('\\'(A,C),A,B)).
cnf(sos,watchlist,'L'('\\'(A,B),A,C) = '\\'('*'(A,C),'*'(C,B))).
cnf(sos,watchlist,'*'('L'(A,B,C),'*'(B,C)) = '*'(C,'*'(A,B))).
cnf(sos,watchlist,'*'('*'(A,B),'L'(C,A,B)) = '*'(B,'*'(C,A))).
cnf(sos,watchlist,'\\'(A,'*'('\\'(B,A),'*'(C,B))) ='L'(C,B,'\\'(B,A))).
cnf(sos,watchlist,'\\'('L'(A,B,C),'*'(C,'*'(A,B))) = '*'(B,C)).
cnf(sos,watchlist,~ '*'(A,'*'(B,C)) = '*'(D,'*'(C,A)) |'L'(B,C,A) = D).
cnf(sos,watchlist,~ '*'(A,'*'(B,C)) = '*'(C,B) |'K'(C,B) = A).
cnf(sos,watchlist,'K'(A,B) ='1').
cnf(sos,watchlist,~ '*'(A,B) = C | C = '*'(B,A)).
cnf(sos,watchlist,~ '*'(A,B) = C | '*'(B,A) = C).
cnf(sos,watchlist,'\\'(A,'*'(B,'*'(C,'\\'(B,A)))) ='L'(C,'\\'(B,A),B)).
cnf(sos,watchlist,~ A = B | '\\'('\\'(A,C),C) = B).
cnf(sos,watchlist,'\\'('\\'(A,B),B) = '*'(A,'1')).
cnf(sos,watchlist,~ '\\'(A,'*'(B,'*'(C,D))) ='L'(C,D,B) | '*'(B,D) = A).
cnf(sos,watchlist,'*'(A,B) = '\\'('L'(C,B,A),'*'(A,'*'(C,B)))).
cnf(sos,watchlist,'\\'('L'(A,B,C),'*'(C,'*'(A,B))) = '*'(C,B)).
cnf(sos,watchlist,~ A = B | ~ '\\'(C,D) = B | '\\'(A,D) = C ).
cnf(sos,watchlist,~ A = '\\'(B,C) | '\\'(A,C) = B).
cnf(sos,watchlist,~ '\\'(A,B) = C | '\\'(C,B) = A).
cnf(sos,watchlist,~ '\\'(A,B) ='L'('L'(C,D,E),F,V6) | '*'(A,'L'('L'(C,F,V6),D,E)) = B).
cnf(sos,watchlist,'*'('*'(A,B),'L'('L'(C,A,B),D,E)) = '*'(B,'*'(A,'L'(C,D,E)))).
cnf(sos,watchlist,'*'('*'(A,B),'L'('L'(C,B,A),D,E)) = '*'(A,'*'(B,'L'(C,D,E)))).
cnf(sos,watchlist,~ A = B | ~ '*'('\\'(C,A),D) = B | C = D ).
cnf(sos,watchlist,~ A = B | ~ '*'(C,D) = B | '\\'(D,A) = C ).
cnf(sos,watchlist,~ A = '*'(B,C) | '\\'(C,A) = B).
cnf(sos,watchlist,~ '*'(A,B) = C | '\\'(B,C) = A).
cnf(sos,watchlist,~ '\\'(A,B) = '*'('\\'(C,D),C) | '*'(D,A) = B).
cnf(sos,watchlist,'*'(A,'L'(B,C,'\\'(C,A))) = '*'('\\'(C,A),'*'(B,C))).
cnf(sos,watchlist,~ '\\'(A,B) = '*'(C,'\\'(C,D)) | '*'(D,A) = B).
cnf(sos,watchlist,'*'(A,'L'(B,'\\'(C,A),C)) = '*'(C,'*'(B,'\\'(C,A)))).
cnf(sos,watchlist,'\\'('L'(A,'\\'(A,B),C),'*'(C,B)) = '*'(C,'\\'(A,B))).
cnf(sos,watchlist,'*'(a(A,B,C),'*'(A,'*'(B,C))) = '*'(C,'*'(A,B))).
cnf(sos,watchlist,'\\'('*'(A,'*'(B,C)),'*'(B,'*'(A,C))) = a(A,C,B)).
cnf(sos,watchlist,'\\'('*'(A,B),'*'(C,'*'(A,'\\'(C,B)))) = a(A,'\\'(C,B),C)).
cnf(sos,watchlist,'\\'('*'(A,'*'(B,C)),'*'(B,'*'(C,A))) = a(A,C,B)).
cnf(sos,watchlist,'\\'('*'(A,'*'(B,'\\'(A,C))),'*'(B,C)) = a(A,'\\'(A,C),B)).
cnf(sos,watchlist,'\\'('*'(A,'*'(B,'\\'(A,'1'))),B) = a(A,'\\'(A,'1'),B)).
cnf(sos,watchlist,'\\'('*'(A,B),'*'(C,'*'(B,'\\'(C,A)))) = a(B,'\\'(C,A),C)).
cnf(sos,watchlist,'\\'(A,'*'(B,'*'(A,'\\'(B,'1')))) = a(A,'\\'(B,'1'),B)).
cnf(sos,watchlist,'\\'(A,'*'(B,'*'('\\'(C,A),'\\'(B,C)))) = a('\\'(C,A),'\\'(B,C),B)).
cnf(sos,watchlist,'\\'('\\'('\\'(A,'1'),B),'*'(A,B)) = a('\\'('\\'(A,'1'),B),'\\'(A,'1'),A)).
cnf(sos,watchlist,a('\\'('\\'(A,'1'),B),'\\'(A,'1'),A) = '\\'('\\'('\\'(A,'1'),B),'*'(A,B))).
cnf(sos,watchlist,~ '\\'(A,'*'(B,'*'(C,'\\'(B,A)))) = D |'L'(C,'\\'(B,A),B) = D).
cnf(sos,watchlist,'L'(A,'\\'(B,'1'),B) = '*'(B,'*'(A,'\\'(B,'1')))).
cnf(sos,watchlist,'*'(A,'*'(B,'\\'(A,'1'))) ='L'(B,'\\'(A,'1'),A)).
cnf(sos,watchlist,~ '*'(A,B) = '\\'(C,'*'(D,'*'(E,'\\'(D,C)))) | '\\'(A,'L'(E,'\\'(D,C),D)) = B).
cnf(sos,watchlist,'\\'(A,'L'(B,'\\'(A,'1'),A)) = '*'(B,'\\'(A,'1'))).
cnf(sos,watchlist,~ '\\'('1',A) = B | A = B).
cnf(sos,watchlist,~ '*'(A,'*'(B,C)) = D | '*'(A,'*'(C,B)) = D).
cnf(sos,watchlist,'*'(A,'*'('\\'(A,'1'),B)) ='L'(B,'\\'(A,'1'),A)).
cnf(sos,watchlist,'*'(A,B) ='L'('\\'('\\'(A,'1'),B),'\\'(A,'1'),A)).
cnf(sos,watchlist,'L'('\\'('\\'(A,'1'),B),'\\'(A,'1'),A) = '*'(A,B)).
cnf(sos,watchlist,'\\'('L'(A,'\\'(B,'1'),B),A) = a(B,'\\'(B,'1'),A)).
cnf(sos,watchlist,'\\'(A,'L'(A,'\\'(B,'1'),B)) = a(A,'\\'(B,'1'),B)).
cnf(sos,watchlist,'\\'('L'(A,B,'\\'(B,'1')),A) = a('\\'(B,'1'),'\\'('\\'(B,'1'),'1'),A)).
cnf(sos,watchlist,a('\\'(A,'1'),'\\'('\\'(A,'1'),'1'),B) = '\\'('L'(B,A,'\\'(A,'1')),B)).
cnf(sos,watchlist,a('\\'(A,'1'),A,B) = '\\'('L'(B,A,'\\'(A,'1')),B)).
cnf(sos,watchlist,'\\'('L'(A,B,'\\'(B,'1')),A) = a('\\'(B,'1'),B,A)).
cnf(sos,watchlist,~ A = B | '\\'(C,B) = '\\'(C,A)).
cnf(sos,watchlist,'*'(A,'*'('\\'(B,'1'),'\\'(A,B))) = a('\\'(B,'1'),'\\'(A,B),A)).
cnf(sos,watchlist,'*'('\\'(A,B),'*'('\\'(B,'1'),A)) = a('\\'(B,'1'),'\\'('\\'(A,B),B),'\\'(A,B))).
cnf(sos,watchlist,a('\\'(A,'1'),'\\'('\\'(B,A),A),'\\'(B,A)) = '*'('\\'(B,A),'*'('\\'(A,'1'),B))).
cnf(sos,watchlist,'*'('\\'(A,'1'),'*'(A,B)) ='L'(B,A,'\\'(A,'1'))).
cnf(sos,watchlist,~ '*'(A,B) = '\\'(C,'*'('\\'(D,C),'*'(D,E))) | '\\'(A,'L'(E,D,'\\'(D,C))) = B).
cnf(sos,watchlist,'\\'('\\'(A,'1'),'L'(B,A,'\\'(A,'1'))) = '*'(A,B)).
cnf(sos,watchlist,'*'('*'(A,B),'\\'(A,'1')) ='L'(B,A,'\\'(A,'1'))).
cnf(sos,watchlist,'*'('\\'(A,'1'),'*'(B,A)) ='L'(B,A,'\\'(A,'1'))).
cnf(sos,watchlist,'*'('\\'(A,'1'),B) ='L'('\\'(A,B),A,'\\'(A,'1'))).
cnf(sos,watchlist,'L'('\\'(A,B),A,'\\'(A,'1')) = '*'('\\'(A,'1'),B)).
cnf(sos,watchlist,'*'('*'(A,B),'\\'(B,'1')) ='L'(A,B,'\\'(B,'1'))).
cnf(sos,watchlist,'*'(A,'\\'(B,'1')) ='L'('\\'(B,A),B,'\\'(B,'1'))).
cnf(sos,watchlist,'L'('\\'(A,B),A,'\\'(A,'1')) = '*'(B,'\\'(A,'1'))).
cnf(sos,watchlist,'*'(A,'\\'('\\'(B,A),'1')) ='L'(B,'\\'(B,A),'\\'('\\'(B,A),'1'))).
cnf(sos,watchlist,'L'(A,'\\'(A,B),'\\'('\\'(A,B),'1')) = '*'(B,'\\'('\\'(A,B),'1'))).
cnf(sos,watchlist,'\\'('*'(A,'\\'('\\'(B,A),C)),'*'(B,C)) = a('\\'('\\'(B,A),C),'\\'(B,A),B)).
cnf(sos,watchlist,a('\\'('\\'(A,B),C),'\\'(A,B),A) = '\\'('*'(B,'\\'('\\'(A,B),C)),'*'(A,C))).
cnf(sos,watchlist,a('\\'('\\'(A,B),'1'),'\\'(A,B),A) = '\\'('*'(B,'\\'('\\'(A,B),'1')),A)).
cnf(sos,watchlist,'\\'('\\'(A,B),B) = '*'(A,'K'(C,D))).
cnf(sos,watchlist,~ '\\'(A,B) = C | '/'(B,A) = C).
cnf(sos,watchlist,'/'(A,'\\'(B,A)) = '*'(B,'K'(C,D))).
cnf(sos,watchlist,~ '/'('*'(A,'*'(B,C)),D) = '*'('*'(C,A),'K'('L'(B,C,A),'*'(C,A))) |'R'(B,C,A) = D).
cnf(sos,watchlist,'R'(A,B,C) = '\\'('*'(B,C),'*'(C,'*'(A,B)))).
cnf(sos,watchlist,'\\'('*'(A,B),'*'(B,'*'(C,A))) ='R'(C,A,B)).
cnf(sos,watchlist,~ '\\'('*'(A,B),'*'(B,'*'(C,A))) = D |'L'(C,A,B) = D).
cnf(sos,watchlist,'L'(A,B,C) ='R'(A,B,C)).
cnf(sos,watchlist,'R'(A,B,C) ='L'(A,B,C)).
cnf(sos,watchlist,'\\'('*'(A,B),'*'(B,'*'(A,C))) ='R'(C,A,B)).
cnf(sos,watchlist,~'L'(A,B,C) ='L'('L'(D,B,C),E,F) |'L'(D,E,F) = A).
cnf(sos,watchlist,'L'(A,B,'L'(A,C,D)) = A).
