% *********************************************************
% AIM:  LC => aK1
% (x * (x * y)) * z = x * (x * (y * z)) # label("LC").
% a(K(x,y),z,u) = 1 # label("aK1").
% *********************************************************

% The LADR formulas contain function or predicate symbols
% that are not legal TPTP symbols, and we have replaced those
% symbols with new symbols.  Here is the list of the unaccepted
% symbols and the corresponding replacements.
%
%   (arity 0)        1    '1'
%   (arity 2)        K    'K'
%   (arity 2)        *    '*'
%   (arity 3)        R    'R'
%   (arity 3)        L    'L'
%   (arity 2)        T    'T'
%   (arity 2)        \    '\\'
%   (arity 2)        /    '/'

cnf(sos,axiom,'*'('1',A) = A).
cnf(sos,axiom,'*'(A,'1') = A).
cnf(sos,axiom,'\\'(A,'*'(A,B)) = B).
cnf(sos,axiom,'*'(A,'\\'(A,B)) = B).
cnf(sos,axiom,'/'('*'(A,B),B) = A).
cnf(sos,axiom,'*'('/'(A,B),B) = A).
fof(sos,axiom,! [X0] : ! [X1] : ! [X2] : ! [X3] : (('*'(X0,X1) = X2 & '*'(X0,X3) = X2) => X1 = X3)).
fof(sos,axiom,! [X4] : ! [X5] : ! [X6] : ! [X7] : (('*'(X4,X5) = X6 & '*'(X7,X5) = X6) => X4 = X7)).
fof(sos,axiom,! [X8] : ! [X9] : ! [X10] : ('*'(X8,X9) = '*'(X8,X10) => X9 = X10)).
fof(sos,axiom,! [X11] : ! [X12] : ! [X13] : ('*'(X11,X12) = '*'(X13,X12) => X11 = X13)).
cnf(sos,axiom,~ A = B | '*'(C,A) = '*'(C,B)).
cnf(sos,axiom,~ A = B | '*'(A,C) = '*'(B,C)).
cnf(sos,axiom,'\\'('*'(A,'*'(B,C)),'*'('*'(A,B),C)) = a(A,B,C)).
cnf(sos,axiom,'\\'('*'(A,B),'*'(B,A)) ='K'(B,A)).
cnf(sos,axiom,'\\'('*'(A,B),'*'(A,'*'(B,C))) ='L'(C,B,A)).
cnf(sos,axiom,'/'('*'('*'(A,B),C),'*'(B,C)) ='R'(A,B,C)).
cnf(sos,axiom,'\\'(A,'*'(B,A)) ='T'(B,A)).
fof(sos,axiom,! [X14] : ! [X15] : ! [X16] : (a(X14,X15,X16) ='1' =>'L'(X16,X15,X14) = X16)).
fof(sos,axiom,! [X17] : ! [X18] : ! [X19] : ('L'(X17,X18,X19) = X17 => a(X19,X18,X17) ='1')).
fof(sos,axiom,! [X20] : ! [X21] : ('T'(X20,X21) = X20 =>'T'(X21,X20) = X21)).
fof(sos,axiom,! [X22] : ! [X23] : ('T'(X22,X23) = X22 =>'K'(X22,X23) ='1')).
fof(sos,axiom,! [X24] : ! [X25] : ('K'(X24,X25) ='1' =>'T'(X24,X25) = X24)).
cnf(sos,axiom,'T'('T'(A,B),C) ='T'('T'(A,C),B)).
cnf(sos,axiom,'T'('L'(A,B,C),D) ='L'('T'(A,D),B,C)).
cnf(sos,axiom,'T'('R'(A,B,C),D) ='R'('T'(A,D),B,C)).
cnf(sos,axiom,'L'('R'(A,B,C),D,E) ='R'('L'(A,D,E),B,C)).
cnf(sos,axiom,'L'('L'(A,B,C),D,E) ='L'('L'(A,D,E),B,C)).
cnf(sos,axiom,'R'('R'(A,B,C),D,E) ='R'('R'(A,D,E),B,C)).
cnf(sos,axiom,'*'('*'(A,'*'(A,B)),C) = '*'(A,'*'(A,'*'(B,C)))).
fof(goals,conjecture,! [X26] : ! [X27] : ! [X28] : ! [X29] : a('K'(X26,X27),X28,X29) ='1').

%%%%%%
% The following watchlist correspond exactly to the list of hints provided in the original P9 input file.
%%%%%%

cnf(sos,watchlist,a('K'(A,B),C,D) ='1').
cnf(sos,watchlist,'*'('1',A) = A).
cnf(sos,watchlist,'*'(A,'1') = A).
cnf(sos,watchlist,'\\'(A,'*'(A,B)) = B).
cnf(sos,watchlist,'*'(A,'\\'(A,B)) = B).
cnf(sos,watchlist,'/'('*'(A,B),B) = A).
cnf(sos,watchlist,'*'('/'(A,B),B) = A).
cnf(sos,watchlist,~ '*'(A,B) = C | ~ '*'(A,D) = C | D = B).
cnf(sos,watchlist,~ '*'(A,B) = C | ~ '*'(D,B) = C | D = A).
cnf(sos,watchlist,~ '*'(A,B) = '*'(A,C) | B = C).
cnf(sos,watchlist,~ '*'(A,B) = '*'(C,B) | A = C).
cnf(sos,watchlist,~ A = B | '*'(C,A) = '*'(C,B)).
cnf(sos,watchlist,~ A = B | '*'(A,C) = '*'(B,C)).
cnf(sos,watchlist,'\\'('*'(A,'*'(B,C)),'*'('*'(A,B),C)) = a(A,B,C)).
cnf(sos,watchlist,'\\'('*'(A,B),'*'(B,A)) ='K'(B,A)).
cnf(sos,watchlist,'\\'('*'(A,B),'*'(A,'*'(B,C))) ='L'(C,B,A)).
cnf(sos,watchlist,'/'('*'('*'(A,B),C),'*'(B,C)) ='R'(A,B,C)).
cnf(sos,watchlist,'\\'(A,'*'(B,A)) ='T'(B,A)).
cnf(sos,watchlist,~ a(A,B,C) ='1' |'L'(C,B,A) = C).
cnf(sos,watchlist,~'L'(A,B,C) = A | a(C,B,A) ='1').
cnf(sos,watchlist,~'T'(A,B) = A |'T'(B,A) = B).
cnf(sos,watchlist,~'T'(A,B) = A |'K'(A,B) ='1').
cnf(sos,watchlist,~'K'(A,B) ='1' |'T'(A,B) = A).
cnf(sos,watchlist,'T'('T'(A,B),C) ='T'('T'(A,C),B)).
cnf(sos,watchlist,'T'('L'(A,B,C),D) ='L'('T'(A,D),B,C)).
cnf(sos,watchlist,'T'('R'(A,B,C),D) ='R'('T'(A,D),B,C)).
cnf(sos,watchlist,'L'('R'(A,B,C),D,E) ='R'('L'(A,D,E),B,C)).
cnf(sos,watchlist,'R'('L'(A,B,C),D,E) ='L'('R'(A,D,E),B,C)).
cnf(sos,watchlist,'L'('L'(A,B,C),D,E) ='L'('L'(A,D,E),B,C)).
cnf(sos,watchlist,'R'('R'(A,B,C),D,E) ='R'('R'(A,D,E),B,C)).
cnf(sos,watchlist,'*'('*'(A,'*'(A,B)),C) = '*'(A,'*'(A,'*'(B,C)))).
cnf(sos,watchlist,~ a('K'(c1,c2),c3,c4) ='1').
cnf(sos,watchlist,'\\'('1',A) = A).
cnf(sos,watchlist,'\\'(A,A) ='1').
cnf(sos,watchlist,'\\'(A,'*'(A,'\\'(B,'*'(B,C)))) = C).
cnf(sos,watchlist,'*'('*'(A,'\\'(A,'1')),B) = B).
cnf(sos,watchlist,'*'(A,'*'(B,'\\'(B,'1'))) = A).
cnf(sos,watchlist,'*'(A,'*'(B,'\\'(B,'\\'(A,C)))) = C).
cnf(sos,watchlist,'/'(A,A) ='1').
cnf(sos,watchlist,'/'(A,'1') = A).
cnf(sos,watchlist,'*'(A,'/'('*'('\\'(A,B),C),C)) = B).
cnf(sos,watchlist,'/'(A,'\\'(B,A)) = B).
cnf(sos,watchlist,'\\'('/'(A,B),A) = B).
cnf(sos,watchlist,'*'('\\'(A,'*'(A,'/'(B,C))),C) = B).
cnf(sos,watchlist,~ A = B | ~ '*'('1',C) = B | C = A).
cnf(sos,watchlist,~ A = B | ~ '*'(C,D) = B | D = '\\'(C,A)).
cnf(sos,watchlist,~ A = B | ~ '*'(C,D) = B | '\\'(C,A) = D).
cnf(sos,watchlist,~ A = B | ~ '*'(C,D) = B | C = '/'(A,D)).
cnf(sos,watchlist,~ A = B | ~ '*'(C,D) = B | '/'(A,D) = C).
cnf(sos,watchlist,~ A = '*'('1',B) | A = B).
cnf(sos,watchlist,~ '*'('1',A) = B | B = A).
cnf(sos,watchlist,~ '*'('1',A) = B | A = B).
cnf(sos,watchlist,~ A = '*'(A,B) |'1' = B).
cnf(sos,watchlist,~ '*'(A,B) = A |'1' = B).
cnf(sos,watchlist,~ A = '*'(B,C) | '\\'(B,A) = C).
cnf(sos,watchlist,~ '*'(A,B) = C | '\\'(A,C) = B).
cnf(sos,watchlist,~ '*'(A,B) = '*'('/'('*'(A,C),D),D) | B = C).
cnf(sos,watchlist,~ '*'('/'('*'(A,B),C),C) = '*'(A,D) | D = B).
cnf(sos,watchlist,~ '*'(A,'1') = B | A = B).
cnf(sos,watchlist,~ '*'(A,'\\'(B,C)) = C | A = B).
cnf(sos,watchlist,~ A = '*'(B,C) | '/'(A,C) = B).
cnf(sos,watchlist,~ '*'(A,B) = C | '/'(C,B) = A).
cnf(sos,watchlist,~ '*'(A,B) = '*'('/'('*'(C,B),D),D) | A = C).
cnf(sos,watchlist,~ '*'('/'('*'(A,B),C),C) = '*'(D,B) | D = A).
cnf(sos,watchlist,'*'(A,'*'(B,'\\'(B,C))) = '*'(A,C)).
cnf(sos,watchlist,'*'('*'('/'(A,B),B),C) = '*'(A,C)).
cnf(sos,watchlist,'*'('*'(A,'\\'(A,B)),C) = '*'(B,C)).
cnf(sos,watchlist,'*'('*'(A,'*'(B,C)),a(A,B,C)) = '*'('*'(A,B),C)).
cnf(sos,watchlist,'\\'('*'(A,'*'('\\'(A,B),C)),'*'(B,C)) = a(A,'\\'(A,B),C)).
cnf(sos,watchlist,'\\'('*'(A,B),'*'('*'(A,'/'(B,C)),C)) = a(A,'/'(B,C),C)).
cnf(sos,watchlist,'*'('*'(A,B),'K'(B,A)) = '*'(B,A)).
cnf(sos,watchlist,'\\'(A,'*'('\\'(B,A),B)) ='K'('\\'(B,A),B)).
cnf(sos,watchlist,'*'('*'(A,B),'L'(C,B,A)) = '*'(A,'*'(B,C))).
cnf(sos,watchlist,'\\'(A,'*'(B,'*'('\\'(B,A),C))) ='L'(C,'\\'(B,A),B)).
cnf(sos,watchlist,'\\'('*'(A,B),'*'(A,C)) ='L'('\\'(B,C),B,A)).
cnf(sos,watchlist,'L'('\\'(A,B),A,C) = '\\'('*'(C,A),'*'(C,B))).
cnf(sos,watchlist,'\\'('*'(A,'/'(B,C)),'*'(A,B)) ='L'(C,'/'(B,C),A)).
cnf(sos,watchlist,'L'(A,'/'(B,A),C) = '\\'('*'(C,'/'(B,A)),'*'(C,B))).
cnf(sos,watchlist,'/'('*'(A,B),'*'('\\'(C,A),B)) ='R'(C,'\\'(C,A),B)).
cnf(sos,watchlist,'R'(A,'\\'(A,B),C) = '/'('*'(B,C),'*'('\\'(A,B),C))).
cnf(sos,watchlist,'*'('R'(A,B,C),'*'(B,C)) = '*'('*'(A,B),C)).
cnf(sos,watchlist,'/'('*'(A,B),'*'(C,B)) ='R'('/'(A,C),C,B)).
cnf(sos,watchlist,'R'('/'(A,B),B,C) = '/'('*'(A,C),'*'(B,C))).
cnf(sos,watchlist,'/'('*'('*'(A,'/'(B,C)),C),B) ='R'(A,'/'(B,C),C)).
cnf(sos,watchlist,'T'(A,A) = A).
cnf(sos,watchlist,'*'(A,'T'(B,A)) = '*'(B,A)).
cnf(sos,watchlist,'\\'('\\'(A,B),B) ='T'(A,'\\'(A,B))).
cnf(sos,watchlist,'T'(A,'\\'(A,B)) = '\\'('\\'(A,B),B)).
cnf(sos,watchlist,'\\'(A,B) ='T'('/'(B,A),A)).
cnf(sos,watchlist,'T'('/'(A,B),B) = '\\'(B,A)).
cnf(sos,watchlist,~ '*'(A,B) = C | A = '/'(C,B)).
cnf(sos,watchlist,'*'(A,'*'(A,B)) = '/'('*'(A,'*'(A,'*'(B,C))),C)).
cnf(sos,watchlist,'/'('*'(A,'*'(A,'*'(B,C))),C) = '*'(A,'*'(A,B))).
cnf(sos,watchlist,~ '*'(A,B) = C | B = '\\'(A,C)).
cnf(sos,watchlist,A = '\\'('*'(B,'*'(B,C)),'*'(B,'*'(B,'*'(C,A))))).
cnf(sos,watchlist,'\\'('*'(A,'*'(A,B)),'*'(A,'*'(A,'*'(B,C)))) = C).
cnf(sos,watchlist,'*'('*'(A,'*'(A,'1')),B) = '*'(A,'*'(A,B))).
cnf(sos,watchlist,'*'('*'(A,B),C) = '*'(A,'*'(A,'*'('\\'(A,B),C)))).
cnf(sos,watchlist,'*'(A,'*'(A,'*'('\\'(A,B),C))) = '*'('*'(A,B),C)).
cnf(sos,watchlist,'\\'('*'(A,'*'(B,'*'(B,'*'(C,D)))),'*'('*'(A,'*'(B,'*'(B,C))),D)) = a(A,'*'(B,'*'(B,C)),D)).
cnf(sos,watchlist,'\\'('*'(A,'*'(A,'*'(B,'*'(C,D)))),'*'('*'('*'(A,'*'(A,B)),C),D)) = a('*'(A,'*'(A,B)),C,D)).
cnf(sos,watchlist,'\\'('*'(A,'*'(A,'*'(B,C))),'*'('*'(A,'*'(A,B)),'*'(C,D))) ='L'(D,C,'*'(A,'*'(A,B)))).
cnf(sos,watchlist,'\\'('*'(A,'*'(B,'*'(B,C))),'*'(A,'*'(B,'*'(B,'*'(C,D))))) ='L'(D,'*'(B,'*'(B,C)),A)).
cnf(sos,watchlist,'/'('*'('*'(A,'*'(A,'*'(B,C))),D),'*'(C,D)) ='R'('*'(A,'*'(A,B)),C,D)).
cnf(sos,watchlist,'/'('*'(A,'*'(A,'*'(B,C))),'*'('*'(A,B),C)) ='R'(A,'*'(A,B),C)).
cnf(sos,watchlist,~ A = B | ~ C = B | C = A).
cnf(sos,watchlist,~ A = B | A = '*'('/'(B,C),C)).
cnf(sos,watchlist,'/'('*'(A,B),B) = '*'('/'(A,C),C)).
cnf(sos,watchlist,~ A = B | A = '*'(C,'\\'(C,B))).
cnf(sos,watchlist,'*'(A,'1') = '*'(B,'\\'(B,A))).
cnf(sos,watchlist,'*'(A,'\\'(A,B)) = '*'(B,'1')).
cnf(sos,watchlist,'/'('*'(A,'*'(A,B)),C) = '*'(A,'*'(A,'/'(B,C)))).
cnf(sos,watchlist,'L'('\\'(A,'1'),A,B) = '\\'('*'(B,A),B)).
cnf(sos,watchlist,'L'('\\'('\\'(A,B),C),'\\'(A,B),A) = '\\'(B,'*'(A,C))).
cnf(sos,watchlist,'L'('\\'(A,'\\'(B,C)),A,B) = '\\'('*'(B,A),C)).
cnf(sos,watchlist,'L'('\\'(A,B),A,'/'(C,A)) = '\\'(C,'*'('/'(C,A),B))).
cnf(sos,watchlist,'L'('K'(A,B),'*'(B,A),C) = '\\'('*'(C,'*'(B,A)),'*'(C,'*'(A,B)))).
cnf(sos,watchlist,'\\'('*'(A,'*'(B,C)),'*'(A,'*'(C,B))) ='L'('K'(C,B),'*'(B,C),A)).
cnf(sos,watchlist,'L'('L'(A,B,C),'*'(C,B),D) = '\\'('*'(D,'*'(C,B)),'*'(D,'*'(C,'*'(B,A))))).
cnf(sos,watchlist,'\\'('*'(A,'*'(B,C)),'*'(A,'*'(B,'*'(C,D)))) ='L'('L'(D,C,B),'*'(B,C),A)).
cnf(sos,watchlist,'L'('T'(A,B),B,C) = '\\'('*'(C,B),'*'(C,'*'(A,B)))).
cnf(sos,watchlist,'\\'('*'(A,B),'*'(A,'*'(C,B))) ='L'('T'(C,B),B,A)).
cnf(sos,watchlist,'\\'(A,'*'('*'(A,B),C)) = '*'(A,'*'('\\'(A,B),C))).
cnf(sos,watchlist,'*'('\\'('/'(A,B),A),C) = '*'(B,C)).
cnf(sos,watchlist,'*'(A,'\\'('/'(B,'\\'(A,C)),B)) = C).
cnf(sos,watchlist,'\\'('R'(A,B,C),'*'('*'(A,B),C)) = '*'(B,C)).
cnf(sos,watchlist,'*'('R'(A,B,'\\'(B,C)),C) = '*'('*'(A,B),'\\'(B,C))).
cnf(sos,watchlist,'*'('R'(A,'/'(B,C),C),B) = '*'('*'(A,'/'(B,C)),C)).
cnf(sos,watchlist,~ '*'('*'(A,B),C) = '*'(D,'*'(B,C)) |'R'(A,B,C) = D).
cnf(sos,watchlist,'/'('*'('*'('*'(A,B),C),D),'*'('*'(B,C),D)) ='R'('R'(A,B,C),'*'(B,C),D)).
cnf(sos,watchlist,'*'('L'('R'(A,B,C),D,E),'*'(B,C)) = '*'('*'('L'(A,D,E),B),C)).
cnf(sos,watchlist,'*'('R'('R'(A,B,C),D,E),'*'(B,C)) = '*'('*'('R'(A,D,E),B),C)).
cnf(sos,watchlist,'*'('R'(A,'R'(B,C,D),'*'(C,D)),'*'('*'(B,C),D)) = '*'('*'(A,'R'(B,C,D)),'*'(C,D))).
cnf(sos,watchlist,~ '*'(A,B) = C | '/'('*'('/'(C,D),D),B) = A).
cnf(sos,watchlist,'/'('*'('/'(A,B),B),C) = '/'(A,C)).
cnf(sos,watchlist,~ '*'(A,B) = '\\'('/'(C,D),C) | '/'(D,B) = A).
cnf(sos,watchlist,'/'(A,'1') = '\\'('/'(B,A),B)).
cnf(sos,watchlist,'\\'('/'(A,B),A) = '/'(B,'1')).
cnf(sos,watchlist,~ '*'(A,B) = '*'(C,'\\'(C,D)) | '/'(D,B) = A).
cnf(sos,watchlist,'/'(A,'1') = '*'(B,'\\'(B,A))).
cnf(sos,watchlist,'*'(A,'\\'(A,B)) = '/'(B,'1')).
cnf(sos,watchlist,~ '*'(A,B) = '*'('1',C) | '/'(C,B) = A).
cnf(sos,watchlist,'/'(A,'1') = '*'('1',A)).
cnf(sos,watchlist,'*'(A,'*'(B,'\\'(B,C))) = '*'(D,'\\'(D,'*'(A,C)))).
cnf(sos,watchlist,'*'(A,'\\'(A,'*'(B,C))) = '*'(B,'*'(D,'\\'(D,C)))).
cnf(sos,watchlist,~ '*'(A,B) = '*'(C,'1') | '/'(C,B) = A).
cnf(sos,watchlist,'/'(A,'*'(B,'\\'(B,'1'))) = A).
cnf(sos,watchlist,~ '/'(A,'1') = B | B = A).
cnf(sos,watchlist,~ '\\'('/'(A,B),A) = C | C = B).
cnf(sos,watchlist,~ '\\'(A,'*'(A,B)) = C | C = B).
cnf(sos,watchlist,~ '\\'('*'(A,'*'(A,B)),'*'(A,'*'(A,'*'(B,C)))) = D | D = C).
cnf(sos,watchlist,'L'('L'(A,B,C),'*'(C,B),C) = A).
cnf(sos,watchlist,~'L'('L'(A,B,C),'*'(C,B),C) = D | D = A).
cnf(sos,watchlist,'L'('L'(A,'*'(B,C),B),C,B) = A).
cnf(sos,watchlist,~'L'('L'(A,'*'(B,C),B),C,B) = D | D = A).
cnf(sos,watchlist,~ '*'(A,B) = '*'(C,'*'(D,'\\'(D,E))) | '/'('*'(C,E),B) = A).
cnf(sos,watchlist,'/'('*'(A,B),'L'('\\'(C,B),C,A)) = '*'(A,C)).
cnf(sos,watchlist,~ '*'(A,B) = '*'('/'(C,D),D) | '/'(C,B) = A).
cnf(sos,watchlist,'/'(A,'L'(B,C,'/'(A,'*'(C,B)))) = '*'('/'(A,'*'(C,B)),C)).
cnf(sos,watchlist,'/'('*'(A,'*'(B,C)),'L'(C,B,A)) = '*'(A,B)).
cnf(sos,watchlist,~ '*'(A,B) = '*'(C,'*'(D,E)) | '\\'(A,'*'('*'(C,D),'L'(E,D,C))) = B).
cnf(sos,watchlist,'\\'(A,'*'('*'(A,B),'L'(C,B,A))) = '*'(B,C)).
cnf(sos,watchlist,'*'(A,'L'(B,'\\'(C,A),C)) = '*'(C,'*'('\\'(C,A),B))).
cnf(sos,watchlist,~ '*'(A,'*'(B,C)) = '*'('*'(A,B),D) |'L'(C,B,A) = D).
cnf(sos,watchlist,~ '*'('*'(A,B),C) = '*'(A,'*'(B,D)) |'L'(D,B,A) = C).
cnf(sos,watchlist,~ '*'('*'(A,B),'L'(C,B,A)) = '*'(A,D) | '*'(B,C) = D).
cnf(sos,watchlist,'\\'('*'(A,'*'(B,C)),'*'('*'(A,B),'*'('L'(C,B,A),D))) ='L'(D,'L'(C,B,A),'*'(A,B))).
cnf(sos,watchlist,'/'('*'('*'(A,'*'(B,C)),D),'*'('L'(C,B,A),D)) ='R'('*'(A,B),'L'(C,B,A),D)).
cnf(sos,watchlist,'/'('*'('*'(A,'*'(B,C)),'L'(D,C,B)),'*'(B,'*'(C,D))) ='R'(A,'*'(B,C),'L'(D,C,B))).
cnf(sos,watchlist,'*'('*'(A,B),'T'('L'(C,B,A),D)) = '*'(A,'*'(B,'T'(C,D)))).
cnf(sos,watchlist,'*'('*'(A,B),'R'('L'(C,B,A),D,E)) = '*'(A,'*'(B,'R'(C,D,E)))).
