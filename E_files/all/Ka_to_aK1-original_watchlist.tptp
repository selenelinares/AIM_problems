cnf(sos,watchlist,'R'('K'(A,B),'R'('\\'(A,'1'),C,D),E) ='K'(A,B)).
cnf(sos,watchlist,'R'('K'(A,B),'*'('R'('\\'(A,'1'),C,D),E),'1') ='R'('K'(A,B),'R'('\\'(A,'1'),C,D),E)).
cnf(sos,watchlist,'R'('K'(A,B),'*'('R'('\\'(A,'1'),C,D),E),a('K'(A,B),'R'('\\'(A,'1'),C,D),E)) ='R'('K'(A,B),'R'('\\'(A,'1'),C,D),E)).
cnf(sos,watchlist,'R'('K'(A,B),'*'('R'('\\'(A,'1'),C,D),E),a('K'(A,B),'R'('\\'(A,'1'),C,D),E)) = '/'('*'('R'('\\'(A,'K'(A,B)),C,D),E),'*'('R'('\\'(A,'1'),C,D),E))).
cnf(sos,watchlist,'R'('K'(A,B),'*'('R'('\\'(A,'1'),C,D),E),a('K'(A,B),'R'('\\'(A,'1'),C,D),E)) = '/'('*'('R'('\\'(A,'K'(A,B)),C,D),E),'*'('*'('R'('\\'(A,'1'),C,D),E),'1'))).
cnf(sos,watchlist,'/'('*'('R'('\\'(A,'K'(A,B)),C,D),E),'*'('*'('R'('\\'(A,'1'),C,D),E),'1')) ='R'('K'(A,B),'*'('R'('\\'(A,'1'),C,D),E),a('K'(A,B),'R'('\\'(A,'1'),C,D),E))).
cnf(sos,watchlist,a('K'(A,B),'R'('\\'(A,'1'),C,D),E) ='1').
cnf(sos,watchlist,'/'('*'('R'('/'('K'(A,B),A),C,D),E),'*'('R'('/'('K'(A,B),A),C,D),E)) = a('K'(A,B),'R'('\\'(A,'1'),C,D),E)).
cnf(sos,watchlist,'*'('K'(A,B),'*'('R'('/'('1',A),C,D),E)) = '*'('R'('/'('K'(A,B),A),C,D),E)).
