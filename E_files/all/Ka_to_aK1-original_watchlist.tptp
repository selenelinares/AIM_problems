cnf(sos,watchlist,'*'('K'(A,'\\'('/'('K'(B,A),B),'1')),'*'('\\'('/'('1','/'('K'(B,A),B)),'1'),C)) = '*'('\\'('/'('1','/'('1',B)),'1'),C)).
cnf(sos,watchlist,'*'('K'(A,'/'('1','/'('K'(B,A),B))),'*'('\\'('/'('1','/'('K'(B,A),B)),'1'),C)) = '*'('\\'('/'('1','/'('1',B)),'1'),C)).
cnf(sos,watchlist,'*'('K'(A,B),'*'('\\'(B,'1'),C)) = '*'('\\'('T'(B,A),'1'),C)).
