% ***************
% AIM:  Ka => aK1
% ***************

% The LADR formulas contain function or predicate symbols
% that are not legal TPTP symbols, and we have replaced those
% symbols with new symbols.  Here is the list of the unaccepted
% symbols and the corresponding replacements.
%
%   (arity 0)        1    '1'
%   (arity 2)        K    'K'
%   (arity 3)        R    'R'
%   (arity 3)        L    'L'
%   (arity 2)        T    'T'
%   (arity 2)        *    '*'
%   (arity 2)        \    '\\'
%   (arity 2)        /    '/'

cnf(sos,axiom,'*'('1',A) = A).
cnf(sos,axiom,'*'(A,'1') = A).
cnf(sos,axiom,'\\'(A,'*'(A,B)) = B).
cnf(sos,axiom,'*'(A,'\\'(A,B)) = B).
cnf(sos,axiom,'/'('*'(A,B),B) = A).
cnf(sos,axiom,'*'('/'(A,B),B) = A).
fof(sos,axiom,! [X0] : ! [X1] : ! [X2] : ! [X3] : (('*'(X0,X1) = X2 & '*'(X0,X3) = X2) => X1 = X3)).
fof(sos,axiom,! [X4] : ! [X5] : ! [X6] : ! [X7] : (('*'(X4,X5) = X6 & '*'(X7,X5) = X6) => X4 = X7)).
fof(sos,axiom,! [X8] : ! [X9] : ! [X10] : ('*'(X8,X9) = '*'(X8,X10) => X9 = X10)).
fof(sos,axiom,! [X11] : ! [X12] : ! [X13] : ('*'(X11,X12) = '*'(X13,X12) => X11 = X13)).
cnf(sos,axiom,'\\'('*'(A,'*'(B,C)),'*'('*'(A,B),C)) = a(A,B,C)).
cnf(sos,axiom,'\\'('*'(A,B),'*'(B,A)) ='K'(B,A)).
cnf(sos,axiom,'\\'('*'(A,B),'*'(A,'*'(B,C))) ='L'(C,B,A)).
cnf(sos,axiom,'/'('*'('*'(A,B),C),'*'(B,C)) ='R'(A,B,C)).
cnf(sos,axiom,'\\'(A,'*'(B,A)) ='T'(B,A)).
fof(sos,axiom,! [X14] : ! [X15] : ! [X16] : (a(X14,X15,X16) ='1' =>'L'(X16,X15,X14) = X16)).
fof(sos,axiom,! [X17] : ! [X18] : ! [X19] : ('L'(X17,X18,X19) = X17 => a(X19,X18,X17) ='1')).
fof(sos,axiom,! [X20] : ! [X21] : ('T'(X20,X21) = X20 =>'T'(X21,X20) = X21)).
fof(sos,axiom,! [X22] : ! [X23] : ('T'(X22,X23) = X22 =>'K'(X22,X23) ='1')).
fof(sos,axiom,! [X24] : ! [X25] : ('K'(X24,X25) ='1' =>'T'(X24,X25) = X24)).
cnf(sos,axiom,'T'('T'(A,B),C) ='T'('T'(A,C),B)).
cnf(sos,axiom,'T'('L'(A,B,C),D) ='L'('T'(A,D),B,C)).
cnf(sos,axiom,'T'('R'(A,B,C),D) ='R'('T'(A,D),B,C)).
cnf(sos,axiom,'L'('R'(A,B,C),D,E) ='R'('L'(A,D,E),B,C)).
cnf(sos,axiom,'L'('L'(A,B,C),D,E) ='L'('L'(A,D,E),B,C)).
cnf(sos,axiom,'R'('R'(A,B,C),D,E) ='R'('R'(A,D,E),B,C)).
cnf(sos,axiom,'K'(a(A,B,C),D) ='1').
fof(goals,conjecture,! [X26] : ! [X27] : ! [X28] : ! [X29] : a('K'(X26,X27),X28,X29) ='1').


% ***************
% Original list of P9 hints
% ***************
cnf(sos,watchlist,'1' = a('K'(A,B),C,D)).
cnf(sos,watchlist,'*'('K'(A,B),'R'('K'(B,A),C,D)) ='1').
cnf(sos,watchlist,'*'('K'(A,B),'/'('*'('*'('K'(B,A),C),D),'*'(C,D))) ='1').
cnf(sos,watchlist,'*'('K'(A,B),'/'('*'('*'('\\'(B,'K'(B,A)),'\\'('\\'(B,'1'),C)),D),'*'(C,D))) ='1').
cnf(sos,watchlist,'*'('\\'(A,'K'(A,B)),'\\'('\\'(A,'1'),C)) = '*'('K'(A,B),C)).
cnf(sos,watchlist,'*'('*'('K'(A,B),'\\'(A,'1')),'\\'('\\'(A,'1'),C)) = '*'('K'(A,B),C)).
cnf(sos,watchlist,'*'('K'(A,B),C) = '*'('*'('K'(A,B),'\\'(A,'1')),'\\'('\\'(A,'1'),C))).
