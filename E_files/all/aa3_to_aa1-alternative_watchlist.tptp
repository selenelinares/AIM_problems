% ****************
% AIM:  aa3 => aa1
% ****************

% The LADR formulas contain function or predicate symbols
% that are not legal TPTP symbols, and we have replaced those
% symbols with new symbols.  Here is the list of the unaccepted
% symbols and the corresponding replacements.
%
%   (arity 0)        1    '1'
%   (arity 3)        R    'R'
%   (arity 3)        L    'L'
%   (arity 2)        T    'T'
%   (arity 2)        K    'K'
%   (arity 2)        *    '*'
%   (arity 2)        \    '\\'
%   (arity 2)        /    '/'

cnf(ax1,axiom,'*'('1',A) = A).
cnf(ax2,axiom,'*'(A,'1') = A).
cnf(ax3,axiom,'\\'(A,'*'(A,B)) = B).
cnf(ax4,axiom,'*'(A,'\\'(A,B)) = B).
cnf(ax5,axiom,'/'('*'(A,B),B) = A).
cnf(ax6,axiom,'*'('/'(A,B),B) = A).
fof(ax7,axiom,! [X0] : ! [X1] : ! [X2] : ! [X3] : (('*'(X0,X1) = X2 & '*'(X0,X3) = X2) => X1 = X3)).
fof(ax8,axiom,! [X4] : ! [X5] : ! [X6] : ! [X7] : (('*'(X4,X5) = X6 & '*'(X7,X5) = X6) => X4 = X7)).
fof(ax9,axiom,! [X8] : ! [X9] : ! [X10] : ('*'(X8,X9) = '*'(X8,X10) => X9 = X10)).
fof(ax10,axiom,! [X11] : ! [X12] : ! [X13] : ('*'(X11,X12) = '*'(X13,X12) => X11 = X13)).
cnf(associator,axiom,'\\'('*'(A,'*'(B,C)),'*'('*'(A,B),C)) = a(A,B,C)).
cnf(commutator,axiom,'\\'('*'(A,B),'*'(B,A)) ='K'(B,A)).
cnf(ax13,axiom,'\\'('*'(A,B),'*'(A,'*'(B,C))) ='L'(C,B,A)).
cnf(ax14,axiom,'/'('*'('*'(A,B),C),'*'(B,C)) ='R'(A,B,C)).
cnf(ax15,axiom,'\\'(A,'*'(B,A)) ='T'(B,A)).
fof(ax16,axiom,! [X14] : ! [X15] : ! [X16] : (a(X14,X15,X16) ='1' =>'L'(X16,X15,X14) = X16)).
fof(ax17,axiom,! [X17] : ! [X18] : ! [X19] : ('L'(X17,X18,X19) = X17 => a(X19,X18,X17) ='1')).
fof(ax18,axiom,! [X20] : ! [X21] : ('T'(X20,X21) = X20 =>'T'(X21,X20) = X21)).
fof(ax19,axiom,! [X22] : ! [X23] : ('T'(X22,X23) = X22 =>'K'(X22,X23) ='1')).
fof(ax20,axiom,! [X24] : ! [X25] : ('K'(X24,X25) ='1' =>'T'(X24,X25) = X24)).
cnf(ax21,axiom,'T'('T'(A,B),C) ='T'('T'(A,C),B)).
cnf(ax22,axiom,'T'('L'(A,B,C),D) ='L'('T'(A,D),B,C)).
cnf(ax23,axiom,'T'('R'(A,B,C),D) ='R'('T'(A,D),B,C)).
cnf(ax24,axiom,'L'('R'(A,B,C),D,E) ='R'('L'(A,D,E),B,C)).
cnf(ax25,axiom,'L'('L'(A,B,C),D,E) ='L'('L'(A,D,E),B,C)).
cnf(ax26,axiom,'R'('R'(A,B,C),D,E) ='R'('R'(A,D,E),B,C)).
cnf(aa3,axiom,a(A,B,a(C,D,E)) ='1').
fof(aa1_conj,conjecture,! [X26] : ! [X27] : ! [X28] : ! [X29] : ! [X30] : a(a(X26,X27,X28),X29,X30) ='1').

%% Watchlist containing all (and only) proof steps 
cnf(sos,watchlist,~ '*'(A,B) = C | ~ '*'(D,B) = C | D = A ).
cnf(sos,watchlist,~ '*'(A,B) = '*'(A,C) | B = C).
cnf(sos,watchlist,~ '*'(A,B) = '*'(C,B) | A = C).
cnf(sos,watchlist,a(A,B,C) = '\\'('*'(A,'*'(B,C)),'*'('*'(A,B),C))).
cnf(sos,watchlist,'K'(A,B) = '\\'('*'(B,A),'*'(A,B))).
cnf(sos,watchlist,'L'(A,B,C) = '\\'('*'(C,B),'*'(C,'*'(B,A)))).
cnf(sos,watchlist,'R'(A,B,C) = '/'('*'('*'(A,B),C),'*'(B,C))).
cnf(sos,watchlist,'T'(A,B) = '\\'(B,'*'(A,B))).
cnf(sos,watchlist,~ a(A,B,C) ='1' |'L'(C,B,A) = C).
cnf(sos,watchlist,~'L'(A,B,C) = A | a(C,B,A) ='1').
cnf(sos,watchlist,~'T'(A,B) = A |'T'(B,A) = B).
cnf(sos,watchlist,~'T'(A,B) = A |'K'(A,B) ='1').
cnf(sos,watchlist,~'K'(A,B) ='1' |'T'(A,B) = A).
cnf(sos,watchlist,'L'('T'(A,B),C,D) ='T'('L'(A,C,D),B)).
cnf(sos,watchlist,'R'('T'(A,B),C,D) ='T'('R'(A,C,D),B)).
cnf(sos,watchlist,'R'('L'(A,B,C),D,E) ='L'('R'(A,D,E),B,C)).
cnf(sos,watchlist,'\\'('1',A) = A).
cnf(sos,watchlist,'\\'(A,A) ='1').
cnf(sos,watchlist,'/'(A,'1') = A).
cnf(sos,watchlist,'/'(A,'\\'(B,A)) = B).
cnf(sos,watchlist,'\\'('/'(A,B),A) = B).
cnf(sos,watchlist,~ '*'(A,B) = C | '\\'(A,C) = B).
cnf(sos,watchlist,~ '*'(A,'1') = B | A = B).
cnf(sos,watchlist,~ '*'(A,B) = C | '/'(C,B) = A).
cnf(sos,watchlist,'*'('*'(A,'*'(B,C)),a(A,B,C)) = '*'('*'(A,B),C)).
cnf(sos,watchlist,'\\'('*'(A,B),'*'('*'(A,C),'\\'(C,B))) = a(A,C,'\\'(C,B))).
cnf(sos,watchlist,'*'('*'(A,B),'K'(B,A)) = '*'(B,A)).
cnf(sos,watchlist,'\\'('*'('\\'(A,B),A),B) ='K'(A,'\\'(A,B))).
cnf(sos,watchlist,'*'('*'(A,B),'L'(C,B,A)) = '*'(A,'*'(B,C))).
cnf(sos,watchlist,'\\'(A,'*'(B,'*'('\\'(B,A),C))) ='L'(C,'\\'(B,A),B)).
cnf(sos,watchlist,'L'('\\'(A,B),A,C) = '\\'('*'(C,A),'*'(C,B))).
cnf(sos,watchlist,'\\'(A,'*'('/'(A,B),'*'(B,C))) ='L'(C,B,'/'(A,B))).
cnf(sos,watchlist,'R'(A,'\\'(A,B),C) = '/'('*'(B,C),'*'('\\'(A,B),C))).
cnf(sos,watchlist,'/'('*'('*'(A,B),'\\'(B,C)),C) ='R'(A,B,'\\'(B,C))).
cnf(sos,watchlist,'*'('R'(A,B,C),'*'(B,C)) = '*'('*'(A,B),C)).
cnf(sos,watchlist,'R'('/'(A,B),B,C) = '/'('*'(A,C),'*'(B,C))).
cnf(sos,watchlist,'/'('*'('*'(A,'/'(B,C)),C),B) ='R'(A,'/'(B,C),C)).
cnf(sos,watchlist,'T'(A,A) = A).
cnf(sos,watchlist,'*'(A,'T'(B,A)) = '*'(B,A)).
cnf(sos,watchlist,'T'(A,'\\'(A,B)) = '\\'('\\'(A,B),B)).
cnf(sos,watchlist,'T'('/'(A,B),B) = '\\'(B,A)).
cnf(sos,watchlist,'T'('T'('T'(A,B),C),D) ='T'('T'('T'(A,D),B),C)).
cnf(sos,watchlist,'L'(a(A,B,C),D,E) = a(A,B,C)).
cnf(sos,watchlist,'T'('T'(A,B),A) ='T'(A,B)).
cnf(sos,watchlist,'/'('*'(A,B),'K'(A,B)) = '*'(B,A)).
cnf(sos,watchlist,'/'('*'(A,B),'T'(A,B)) = B).
cnf(sos,watchlist,'\\'('R'(A,B,C),'*'('*'(A,B),C)) = '*'(B,C)).
cnf(sos,watchlist,~ '*'(A,B) = '*'(C,A) |'T'(C,A) = B).
cnf(sos,watchlist,'\\'('*'(A,B),'*'(A,'*'(C,B))) ='L'('T'(C,B),B,A)).
cnf(sos,watchlist,'/'('*'('*'(A,B),'T'(C,B)),'*'(C,B)) ='R'(A,B,'T'(C,B))).
cnf(sos,watchlist,'\\'('T'(A,B),'*'(A,B)) ='T'(B,'T'(A,B))).
cnf(sos,watchlist,'*'(A,'T'('T'(B,A),C)) = '*'('T'(B,C),A)).
cnf(sos,watchlist,'*'(A,'L'('T'(B,A),C,D)) = '*'('L'(B,C,D),A)).
cnf(sos,watchlist,'*'(A,'R'('T'(B,A),C,D)) = '*'('R'(B,C,D),A)).
cnf(sos,watchlist,'\\'('*'(A,B),'*'('*'(C,A),B)) ='T'('R'(C,A,B),'*'(A,B))).
cnf(sos,watchlist,'T'('T'('/'(A,B),C),B) ='T'('\\'(B,A),C)).
cnf(sos,watchlist,'T'(A,'T'(A,B)) = A).
cnf(sos,watchlist,'T'('T'('T'(A,B),C),A) ='T'('T'(A,B),C)).
cnf(sos,watchlist,'K'(A,'T'(A,B)) ='1').
cnf(sos,watchlist,'K'('/'(A,B),'\\'(B,A)) ='1').
cnf(sos,watchlist,'/'(A,'T'(B,'\\'(B,A))) = '\\'(B,A)).
cnf(sos,watchlist,'/'('*'('R'(A,B,C),D),'R'('T'(A,D),B,C)) = D).
cnf(sos,watchlist,'K'(A,'\\'('\\'(A,B),B)) ='1').
cnf(sos,watchlist,'T'(A,'\\'('\\'(A,B),B)) = A).
cnf(sos,watchlist,'/'('*'(A,'\\'('\\'(A,B),B)),A) = '\\'('\\'(A,B),B)).
cnf(sos,watchlist,'L'('T'(A,'\\'('L'(A,B,C),D)),B,C) = '\\'('\\'('L'(A,B,C),D),D)).
cnf(sos,watchlist,'/'(A,'L'('T'(B,'\\'('L'(B,C,D),A)),C,D)) = '\\'('L'(B,C,D),A)).
cnf(sos,watchlist,'L'('T'(a(A,B,C),D),E,F) ='T'(a(A,B,C),D)).
cnf(sos,watchlist,'L'('R'(a(A,B,C),D,E),F,V6) ='R'(a(A,B,C),D,E)).
cnf(sos,watchlist,'*'('T'('/'(A,B),C),B) = '*'(B,'T'('\\'(B,A),C))).
cnf(sos,watchlist,'T'('T'('\\'('\\'(A,B),B),C),A) ='T'('T'(A,'\\'(A,B)),C)).
cnf(sos,watchlist,~ '*'('*'(A,B),C) = '*'(A,'*'(B,D)) |'L'(D,B,A) = C).
cnf(sos,watchlist,'\\'('*'(A,'*'(B,C)),'*'('*'(A,B),'*'('L'(C,B,A),D))) ='L'(D,'L'(C,B,A),'*'(A,B))).
cnf(sos,watchlist,'\\'('*'(A,'*'(B,C)),'*'(A,'*'(B,'*'(C,D)))) ='L'('L'(D,C,B),'*'(B,C),A)).
cnf(sos,watchlist,'/'('*'(A,'*'(B,C)),'*'(B,'L'(C,B,A))) ='R'(A,B,'L'(C,B,A))).
cnf(sos,watchlist,'\\'('L'(A,B,C),'*'(C,'*'(B,A))) ='T'('*'(C,B),'L'(A,B,C))).
cnf(sos,watchlist,'*'('*'(A,B),'L'('L'(C,B,A),D,E)) = '*'(A,'*'(B,'L'(C,D,E)))).
cnf(sos,watchlist,'*'('*'(A,B),'L'(C,'T'(A,B),B)) = '*'(B,'*'('T'(A,B),C))).
cnf(sos,watchlist,'*'('*'(A,B),a(C,D,E)) = '*'(A,'*'(B,a(C,D,E)))).
cnf(sos,watchlist,'L'('\\'(A,'1'),A,B) = '\\'('*'(B,A),B)).
cnf(sos,watchlist,'L'('\\'('\\'(A,B),C),'\\'(A,B),A) = '\\'(B,'*'(A,C))).
cnf(sos,watchlist,'L'('\\'(A,'\\'(B,C)),A,B) = '\\'('*'(B,A),C)).
cnf(sos,watchlist,'L'('\\'(A,B),A,'/'(C,A)) = '\\'(C,'*'('/'(C,A),B))).
cnf(sos,watchlist,'L'('\\'(A,B),A,'/'(C,B)) = '\\'('*'('/'(C,B),A),C)).
cnf(sos,watchlist,'\\'('*'(A,'*'(B,'*'(C,D))),'*'(A,'*'('*'(B,C),D))) ='L'(a(B,C,D),'*'(B,'*'(C,D)),A)).
cnf(sos,watchlist,'L'('\\'(A,'*'(B,A)),A,B) ='T'(B,'*'(B,A))).
cnf(sos,watchlist,'L'('L'('\\'(A,B),C,D),A,E) ='L'('\\'('*'(E,A),'*'(E,B)),C,D)).
cnf(sos,watchlist,'/'('*'(A,B),'L'('\\'(C,B),C,A)) = '*'(A,C)).
cnf(sos,watchlist,'L'('\\'(A,'L'(B,C,D)),A,'*'(D,C)) = '\\'('*'('*'(D,C),A),'*'(D,'*'(C,B)))).
cnf(sos,watchlist,'L'('L'('\\'(A,B),A,C),'*'(C,A),D) = '\\'('*'(D,'*'(C,A)),'*'(D,'*'(C,B)))).
cnf(sos,watchlist,'L'('\\'(A,'1'),A,'/'(B,A)) = '\\'(B,'/'(B,A))).
cnf(sos,watchlist,'/'(A,'L'('\\'(B,'1'),B,A)) = '*'(A,B)).
cnf(sos,watchlist,'/'(A,'L'(B,'/'('1',B),A)) = '*'(A,'/'('1',B))).
cnf(sos,watchlist,'\\'('*'('*'(A,B),C),'*'('R'(A,B,C),'*'('*'(B,C),D))) ='L'(D,'*'(B,C),'R'(A,B,C))).
cnf(sos,watchlist,'*'('L'('R'(A,B,C),D,E),'*'(B,C)) = '*'('*'('L'(A,D,E),B),C)).
cnf(sos,watchlist,'R'('/'('1',A),A,B) = '/'(B,'*'(A,B))).
cnf(sos,watchlist,'R'('/'(A,B),B,'\\'(B,C)) = '/'('*'(A,'\\'(B,C)),C)).
cnf(sos,watchlist,'R'('/'('/'(A,B),C),C,B) = '/'(A,'*'(C,B))).
cnf(sos,watchlist,'R'('/'(A,'/'(B,C)),'/'(B,C),C) = '/'('*'(A,C),B)).
cnf(sos,watchlist,'T'('/'(A,'*'(B,A)),C) ='R'('T'('/'('1',B),C),B,A)).
cnf(sos,watchlist,'\\'('R'(A,'\\'(A,B),C),'*'(B,C)) = '*'('\\'(A,B),C)).
cnf(sos,watchlist,'\\'('R'(A,B,'K'(B,A)),'*'(B,A)) = '*'(B,'K'(B,A))).
cnf(sos,watchlist,'\\'('R'('*'(A,B),'L'(C,B,A),D),'*'('*'(A,'*'(B,C)),D)) = '*'('L'(C,B,A),D)).
cnf(sos,watchlist,'L'('T'(A,B),B,A) ='T'(A,'*'(A,B))).
cnf(sos,watchlist,'L'('T'('T'(A,B),C),B,A) ='T'('T'(A,'*'(A,B)),C)).
cnf(sos,watchlist,'L'('L'('T'(A,B),C,D),B,A) ='L'('T'(A,'*'(A,B)),C,D)).
cnf(sos,watchlist,'/'(A,'L'('\\'(B,C),B,'/'(A,C))) = '*'('/'(A,C),B)).
cnf(sos,watchlist,'/'('*'(A,B),'L'(C,'/'(B,C),A)) = '*'(A,'/'(B,C))).
cnf(sos,watchlist,'*'(A,'/'('1',a(B,C,D))) = '/'(A,a(B,C,D))).
cnf(sos,watchlist,'*'(A,'L'('R'('T'(B,A),C,D),E,F)) = '*'('L'('R'(B,C,D),E,F),A)).
cnf(sos,watchlist,'*'('L'(A,B,C),A) = '*'(A,'L'(A,B,C))).
cnf(sos,watchlist,'*'(A,'T'(B,'*'(B,A))) = '*'('L'(B,A,B),A)).
cnf(sos,watchlist,'T'(A,'L'(A,B,C)) = A).
cnf(sos,watchlist,'*'('R'(A,B,C),A) = '*'(A,'R'(A,B,C))).
cnf(sos,watchlist,'T'(A,'R'(A,B,C)) = A).
cnf(sos,watchlist,'/'('*'(A,'T'('\\'(A,B),C)),A) ='T'('/'(B,A),C)).
cnf(sos,watchlist,'/'('*'(A,'T'(B,C)),A) ='T'('/'('*'(A,B),A),C)).
cnf(sos,watchlist,'T'('/'('*'(A,B),A),'*'(B,A)) = '/'('*'('L'(B,A,B),A),A)).
cnf(sos,watchlist,'*'(A,'*'('\\'(A,'1'),B)) ='L'(B,'\\'(A,'1'),A)).
cnf(sos,watchlist,'\\'(A,'L'(B,'\\'(A,'1'),A)) = '*'('\\'(A,'1'),B)).
cnf(sos,watchlist,'*'('\\'(A,'1'),a(B,C,D)) = '\\'(A,a(B,C,D))).
cnf(sos,watchlist,'\\'('/'('1',A),a(B,C,D)) = '*'(A,a(B,C,D))).
cnf(sos,watchlist,'/'(a(A,B,C),'*'(D,a(A,B,C))) = '/'('1',D)).
cnf(sos,watchlist,'/'('1','/'(A,a(B,C,D))) = '/'(a(B,C,D),A)).
cnf(sos,watchlist,'\\'('/'(a(A,B,C),D),'1') = '/'(D,a(A,B,C))).
cnf(sos,watchlist,'/'('1',a(A,B,C)) = '\\'(a(A,B,C),'1')).
cnf(sos,watchlist,'*'(A,'\\'(a(B,C,D),'1')) = '/'(A,a(B,C,D))).
cnf(sos,watchlist,'\\'('*'(A,'/'(B,a(C,D,E))),'*'('*'(A,B),'\\'(a(C,D,E),'1'))) = a(A,B,'\\'(a(C,D,E),'1'))).
cnf(sos,watchlist,'/'('/'('*'(A,B),a(C,D,E)),'*'(B,'\\'(a(C,D,E),'1'))) ='R'(A,B,'\\'(a(C,D,E),'1'))).
cnf(sos,watchlist,'*'('/'('1',A),'*'(A,B)) ='L'(B,A,'/'('1',A))).
cnf(sos,watchlist,'\\'('/'('1',A),'L'(B,A,'/'('1',A))) = '*'(A,B)).
cnf(sos,watchlist,'L'('\\'(A,B),A,'/'('1',A)) = '*'('/'('1',A),B)).
cnf(sos,watchlist,'R'('L'(A,B,C),'\\'(A,D),E) ='L'('/'('*'(D,E),'*'('\\'(A,D),E)),B,C)).
cnf(sos,watchlist,'*'('*'(A,B),'\\'(B,'1')) ='R'(A,B,'\\'(B,'1'))).
cnf(sos,watchlist,'/'('/'('*'(A,a(B,C,D)),a(B,C,D)),'1') ='R'(A,a(B,C,D),'\\'(a(B,C,D),'1'))).
cnf(sos,watchlist,'/'('R'(A,B,'\\'(B,'1')),'\\'(B,'1')) = '*'(A,B)).
cnf(sos,watchlist,'\\'('*'(A,B),'R'(A,B,'\\'(B,'1'))) = '\\'(B,'1')).
cnf(sos,watchlist,'R'('/'(A,B),B,'\\'(B,'1')) = '*'(A,'\\'(B,'1'))).
cnf(sos,watchlist,'*'('*'(A,'/'('1',B)),B) ='R'(A,'/'('1',B),B)).
cnf(sos,watchlist,'/'('R'(A,'/'('1',B),B),B) = '*'(A,'/'('1',B))).
cnf(sos,watchlist,'L'('\\'(A,B),A,'/'(B,A)) ='T'('/'(B,A),B)).
cnf(sos,watchlist,'L'(A,'/'(B,A),'/'(B,'/'(B,A))) ='T'('/'(B,'/'(B,A)),B)).
cnf(sos,watchlist,'R'('L'('/'(A,B),C,D),B,'\\'(B,E)) ='L'('/'('*'(A,'\\'(B,E)),E),C,D)).
cnf(sos,watchlist,'/'('T'('/'(A,'*'('/'('1',A),A)),B),A) = '*'('T'('/'('1','/'('1',A)),B),'/'('1',A))).
cnf(sos,watchlist,'\\'('R'(A,'\\'(A,'*'(B,C)),'K'(C,B)),'*'(C,B)) = '*'('\\'(A,'*'(B,C)),'K'(C,B))).
cnf(sos,watchlist,'\\'('R'(A,'\\'(A,B),'\\'(a(C,D,E),'1')),'*'(B,'\\'(a(C,D,E),'1'))) = '/'('\\'(A,B),a(C,D,E))).
cnf(sos,watchlist,'*'('*'(A,B),'T'('T'(A,'*'(A,B)),C)) = '*'(A,'*'(B,'T'('T'(A,B),C)))).
cnf(sos,watchlist,'/'('*'(A,B),a(C,D,E)) = '*'(A,'/'(B,a(C,D,E)))).
cnf(sos,watchlist,'R'(A,B,a(C,D,E)) = A).
cnf(sos,watchlist,'*'('R'(A,B,C),'*'('*'(B,C),a(D,E,F))) = '*'('*'('*'(A,B),C),a(D,E,F))).
cnf(sos,watchlist,'*'(A,'*'('*'(B,C),a(A,B,C))) = '*'('*'(A,B),C)).
cnf(sos,watchlist,'/'('/'(A,a(B,C,D)),E) = '/'(A,'*'(E,a(B,C,D)))).
cnf(sos,watchlist,'/'('*'(A,a(B,C,D)),E) = '/'(A,'/'(E,a(B,C,D)))).
cnf(sos,watchlist,'\\'(A,'*'(B,a(C,D,E))) = '*'('\\'(A,B),a(C,D,E))).
cnf(sos,watchlist,'*'(A,'*'(B,'*'(C,a(A,B,C)))) = '*'('*'(A,B),C)).
cnf(sos,watchlist,'*'(A,'*'(B,a(B,A,B))) ='T'('*'(B,A),B)).
cnf(sos,watchlist,'\\'(A,'*'('*'(A,B),C)) = '*'(B,'*'(C,a(A,B,C)))).
cnf(sos,watchlist,'L'('*'(A,a(B,C,A)),C,B) = A).
cnf(sos,watchlist,'L'('T'('*'(A,a(B,C,A)),D),C,B) ='T'(A,D)).
