% The LADR formulas contain function or predicate symbols
% that are not legal TPTP symbols, and we have replaced those
% symbols with new symbols.  Here is the list of the unaccepted
% symbols and the corresponding replacements.
%
%   (arity 0)        1    '1'
%   (arity 2)        *    '*'
%   (arity 2)        /    '/'
%   (arity 3)        R    'R'
%   (arity 3)        L    'L'
%   (arity 2)        T    'T'
%   (arity 2)        K    'K'
%   (arity 2)        \    '\\'

cnf(sos,axiom,'*'('1',A) = A).
cnf(sos,axiom,'*'(A,'1') = A).
cnf(sos,axiom,'\\'(A,'*'(A,B)) = B).
cnf(sos,axiom,'*'(A,'\\'(A,B)) = B).
cnf(sos,axiom,'/'('*'(A,B),B) = A).
cnf(sos,axiom,'*'('/'(A,B),B) = A).
fof(sos,axiom,! [X0] : ! [X1] : ! [X2] : ! [X3] : (('*'(X0,X1) = X2 & '*'(X0,X3) = X2) => X1 = X3)).
fof(sos,axiom,! [X4] : ! [X5] : ! [X6] : ! [X7] : (('*'(X4,X5) = X6 & '*'(X7,X5) = X6) => X4 = X7)).
fof(sos,axiom,! [X8] : ! [X9] : ! [X10] : ('*'(X8,X9) = '*'(X8,X10) => X9 = X10)).
fof(sos,axiom,! [X11] : ! [X12] : ! [X13] : ('*'(X11,X12) = '*'(X13,X12) => X11 = X13)).
cnf(sos,axiom,~ A = B | '*'(C,A) = '*'(C,B)).
cnf(sos,axiom,~ A = B | '*'(A,C) = '*'(B,C)).
cnf(sos,axiom,'\\'('*'(A,'*'(B,C)),'*'('*'(A,B),C)) = a(A,B,C)).
cnf(sos,axiom,'\\'('*'(A,B),'*'(B,A)) ='K'(B,A)).
cnf(sos,axiom,'\\'('*'(A,B),'*'(A,'*'(B,C))) ='L'(C,B,A)).
cnf(sos,axiom,'/'('*'('*'(A,B),C),'*'(B,C)) ='R'(A,B,C)).
cnf(sos,axiom,'\\'(A,'*'(B,A)) ='T'(B,A)).
fof(sos,axiom,! [X14] : ! [X15] : ! [X16] : (a(X14,X15,X16) ='1' =>'L'(X16,X15,X14) = X16)).
fof(sos,axiom,! [X17] : ! [X18] : ! [X19] : ('L'(X17,X18,X19) = X17 => a(X19,X18,X17) ='1')).
fof(sos,axiom,! [X20] : ! [X21] : ('T'(X20,X21) = X20 =>'T'(X21,X20) = X21)).
fof(sos,axiom,! [X22] : ! [X23] : ('T'(X22,X23) = X22 =>'K'(X22,X23) ='1')).
fof(sos,axiom,! [X24] : ! [X25] : ('K'(X24,X25) ='1' =>'T'(X24,X25) = X24)).
cnf(sos,axiom,'T'('T'(A,B),C) ='T'('T'(A,C),B)).
cnf(sos,axiom,'T'('L'(A,B,C),D) ='L'('T'(A,D),B,C)).
cnf(sos,axiom,'T'('R'(A,B,C),D) ='R'('T'(A,D),B,C)).
cnf(sos,axiom,'L'('R'(A,B,C),D,E) ='R'('L'(A,D,E),B,C)).
cnf(sos,axiom,'L'('L'(A,B,C),D,E) ='L'('L'(A,D,E),B,C)).
cnf(sos,axiom,'R'('R'(A,B,C),D,E) ='R'('R'(A,D,E),B,C)).
cnf(sos,axiom,'*'('/'('*'(A,B),A),'*'(A,C)) = '*'(A,'*'(B,C))).
fof(goals,conjecture,! [X26] : ! [X27] : ! [X28] : ! [X29] : ! [X30] : a(a(X26,X27,X28),X29,X30) ='1').

%%%%%%%%%%%%%%%%
% Original list of hints
%%%%%%%%%%%%%%%%

cnf(sos,watchlist,a(a(A,B,C),D,E) ='1').
cnf(sos,watchlist,'*'('1',A) = A).
cnf(sos,watchlist,'*'(A,'1') = A).
cnf(sos,watchlist,'\\'(A,'*'(A,B)) = B).
cnf(sos,watchlist,'*'(A,'\\'(A,B)) = B).
cnf(sos,watchlist,'/'('*'(A,B),B) = A).
cnf(sos,watchlist,'*'('/'(A,B),B) = A).
cnf(sos,watchlist,~ '*'(A,B) = C | ~ '*'(A,D) = C | D = B ).
cnf(sos,watchlist,~ '*'(A,B) = C | ~ '*'(D,B) = C | D = A ).
cnf(sos,watchlist,~ '*'(A,B) = '*'(A,C) | B = C).
cnf(sos,watchlist,~ '*'(A,B) = '*'(C,B) | A = C).
cnf(sos,watchlist,'\\'('*'(A,'*'(B,C)),'*'('*'(A,B),C)) = a(A,B,C)).
cnf(sos,watchlist,'\\'('*'(A,B),'*'(B,A)) ='K'(B,A)).
cnf(sos,watchlist,'\\'('*'(A,B),'*'(A,'*'(B,C))) ='L'(C,B,A)).
cnf(sos,watchlist,'/'('*'('*'(A,B),C),'*'(B,C)) ='R'(A,B,C)).
cnf(sos,watchlist,'\\'(A,'*'(B,A)) ='T'(B,A)).
cnf(sos,watchlist,~ a(A,B,C) ='1' |'L'(C,B,A) = C).
cnf(sos,watchlist,~'L'(A,B,C) = A | a(C,B,A) ='1').
cnf(sos,watchlist,~'T'(A,B) = A |'T'(B,A) = B).
cnf(sos,watchlist,~'T'(A,B) = A |'K'(A,B) ='1').
cnf(sos,watchlist,~'K'(A,B) ='1' |'T'(A,B) = A).
cnf(sos,watchlist,'T'('T'(A,B),C) ='T'('T'(A,C),B)).
cnf(sos,watchlist,'T'('L'(A,B,C),D) ='L'('T'(A,D),B,C)).
cnf(sos,watchlist,'T'('R'(A,B,C),D) ='R'('T'(A,D),B,C)).
cnf(sos,watchlist,'L'('R'(A,B,C),D,E) ='R'('L'(A,D,E),B,C)).
cnf(sos,watchlist,'R'('L'(A,B,C),D,E) ='L'('R'(A,D,E),B,C)).
cnf(sos,watchlist,'*'('/'('*'(A,B),A),'*'(A,C)) = '*'(A,'*'(B,C))).
cnf(sos,watchlist,~ a(a(c1,c2,c3),c4,c5) ='1').
cnf(sos,watchlist,'\\'(A,A) ='1').
cnf(sos,watchlist,'/'(A,'\\'(B,A)) = B).
cnf(sos,watchlist,'\\'('/'(A,B),A) = B).
cnf(sos,watchlist,~ A = '*'(B,C) | '\\'(B,A) = C).
cnf(sos,watchlist,~ '*'(A,B) = C | '\\'(A,C) = B).
cnf(sos,watchlist,~ A = '*'(B,C) | '/'(A,C) = B).
cnf(sos,watchlist,~ '*'(A,B) = C | '/'(C,B) = A).
cnf(sos,watchlist,'*'('*'(A,B),'K'(B,A)) = '*'(B,A)).
cnf(sos,watchlist,'*'('*'(A,B),'L'(C,B,A)) = '*'(A,'*'(B,C))).
cnf(sos,watchlist,'\\'(A,'*'(B,'*'('\\'(B,A),C))) ='L'(C,'\\'(B,A),B)).
cnf(sos,watchlist,'\\'('*'(A,B),'*'(A,C)) ='L'('\\'(B,C),B,A)).
cnf(sos,watchlist,'L'('\\'(A,B),A,C) = '\\'('*'(C,A),'*'(C,B))).
cnf(sos,watchlist,'\\'(A,'*'('/'(A,B),'*'(B,C))) ='L'(C,B,'/'(A,B))).
cnf(sos,watchlist,'*'('R'(A,B,C),'*'(B,C)) = '*'('*'(A,B),C)).
cnf(sos,watchlist,'/'('*'(A,B),'*'(C,B)) ='R'('/'(A,C),C,B)).
cnf(sos,watchlist,'R'('/'(A,B),B,C) = '/'('*'(A,C),'*'(B,C))).
cnf(sos,watchlist,'T'(A,A) = A).
cnf(sos,watchlist,'*'(A,'T'(B,A)) = '*'(B,A)).
cnf(sos,watchlist,'\\'(A,B) ='T'('/'(B,A),A)).
cnf(sos,watchlist,'T'('/'(A,B),B) = '\\'(B,A)).
cnf(sos,watchlist,~ '*'(A,B) = C | A = '/'(C,B)).
cnf(sos,watchlist,'/'('*'(A,B),A) = '/'('*'(A,'*'(B,C)),'*'(A,C))).
cnf(sos,watchlist,'/'('*'(A,'*'(B,C)),'*'(A,C)) = '/'('*'(A,B),A)).
cnf(sos,watchlist,'*'('/'(A,B),'*'(B,C)) = '*'(B,'*'('\\'(B,A),C))).
cnf(sos,watchlist,'*'('/'('*'(A,B),A),C) = '*'(A,'*'(B,'\\'(A,C)))).
cnf(sos,watchlist,'/'('*'(A,'*'(B,C)),'L'(C,B,A)) = '*'(A,B)).
cnf(sos,watchlist,'/'('*'(A,B),'T'(A,B)) = B).
cnf(sos,watchlist,'\\'('R'(A,B,C),'*'('*'(A,B),C)) = '*'(B,C)).
cnf(sos,watchlist,'L'(A,B,'/'('*'(B,A),B)) ='T'('/'('*'(B,A),B),'*'(B,A))).
cnf(sos,watchlist,'T'('/'('*'(A,B),A),'*'(A,B)) ='L'(B,A,'/'('*'(A,B),A))).
cnf(sos,watchlist,'T'(A,B) ='T'('T'(A,B),A)).
cnf(sos,watchlist,'T'('T'(A,B),A) ='T'(A,B)).
cnf(sos,watchlist,'T'('L'(A,B,C),A) ='L'(A,B,C)).
cnf(sos,watchlist,'T'('R'(A,B,C),A) ='R'(A,B,C)).
cnf(sos,watchlist,'\\'('*'(A,B),'*'('T'(A,B),B)) ='K'('T'(A,B),B)).
cnf(sos,watchlist,'\\'('*'(A,B),'*'(A,'*'(C,B))) ='L'('T'(C,B),B,A)).
cnf(sos,watchlist,'\\'('T'(A,B),'*'(A,B)) ='T'(B,'T'(A,B))).
cnf(sos,watchlist,'*'(A,'T'('T'(B,A),C)) = '*'('T'(B,C),A)).
cnf(sos,watchlist,'*'('*'(A,B),'L'(C,'T'(A,B),B)) = '*'(B,'*'('T'(A,B),C))).
cnf(sos,watchlist,'T'('\\'(A,B),C) ='T'('T'('/'(B,A),C),A)).
cnf(sos,watchlist,'T'('T'('/'(A,B),C),B) ='T'('\\'(B,A),C)).
cnf(sos,watchlist,'T'('L'('/'(A,B),C,D),B) ='L'('\\'(B,A),C,D)).
cnf(sos,watchlist,'T'('R'('/'(A,B),C,D),B) ='R'('\\'(B,A),C,D)).
cnf(sos,watchlist,'/'('*'(A,B),'*'(A,C)) = '/'('*'(A,'/'(B,C)),A)).
cnf(sos,watchlist,'/'('*'(A,'/'(B,C)),A) = '/'('*'(A,B),'*'(A,C))).
cnf(sos,watchlist,'\\'(A,'*'(B,'*'('\\'(B,A),C))) ='L'(C,B,'/'(A,B))).
cnf(sos,watchlist,~ '*'(A,'1') = B | A = B).
cnf(sos,watchlist,'/'('*'(A,B),A) = '*'(A,'*'(B,'\\'(A,'1')))).
cnf(sos,watchlist,'*'(A,'*'(B,'\\'(A,'1'))) = '/'('*'(A,B),A)).
cnf(sos,watchlist,'T'(A,'T'(A,B)) = A).
cnf(sos,watchlist,'*'(A,'T'(A,B)) = '*'('T'(A,B),A)).
cnf(sos,watchlist,'*'('T'(A,B),A) = '*'(A,'T'(A,B))).
cnf(sos,watchlist,'L'('T'(A,B),B,A) ='T'(A,'*'(A,B))).
cnf(sos,watchlist,'T'('L'(A,B,C),B) = '\\'('*'(C,B),'*'(C,'*'(A,B)))).
cnf(sos,watchlist,'\\'('*'(A,B),'*'(A,'*'(C,B))) ='T'('L'(C,B,A),B)).
cnf(sos,watchlist,'K'(A,'T'(A,B)) ='1').
cnf(sos,watchlist,'/'('*'(A,'T'(A,B)),A) ='T'(A,B)).
cnf(sos,watchlist,'*'('T'(A,B),C) = '*'(A,'*'('T'(A,B),'\\'(A,C)))).
cnf(sos,watchlist,'*'(A,'*'('T'(A,B),'\\'(A,C))) = '*'('T'(A,B),C)).
cnf(sos,watchlist,'T'('/'('*'(A,B),'*'(A,C)),A) = '\\'(A,'*'(A,'/'(B,C)))).
cnf(sos,watchlist,~ '*'(A,B) = C | B = '\\'(A,C)).
cnf(sos,watchlist,'*'(A,'\\'(B,'1')) = '\\'(B,'/'('*'(B,A),B))).
cnf(sos,watchlist,'\\'(A,'/'('*'(A,B),A)) = '*'(B,'\\'(A,'1'))).
cnf(sos,watchlist,'*'('T'(A,B),'\\'(A,C)) = '\\'(A,'*'('T'(A,B),C))).
cnf(sos,watchlist,'\\'(A,'*'('T'(A,B),C)) = '*'('T'(A,B),'\\'(A,C))).
cnf(sos,watchlist,'\\'(A,'/'(B,A)) = '*'('\\'(A,B),'\\'(A,'1'))).
cnf(sos,watchlist,'*'('\\'(A,B),'\\'(A,'1')) = '\\'(A,'/'(B,A))).
cnf(sos,watchlist,'\\'('\\'(A,B),'\\'(A,'/'(B,A))) = '\\'(A,'1')).
cnf(sos,watchlist,'\\'('\\'(A,'*'(B,A)),'\\'(A,B)) = '\\'(A,'1')).
cnf(sos,watchlist,'\\'('T'(A,B),'\\'(B,A)) = '\\'(B,'1')).
cnf(sos,watchlist,'*'('T'(A,B),'\\'(B,'1')) = '\\'(B,A)).
cnf(sos,watchlist,'/'('\\'(A,B),'\\'(A,'1')) ='T'(B,A)).
cnf(sos,watchlist,'/'(A,'\\'(B,'1')) ='T'('*'(B,A),B)).
cnf(sos,watchlist,'T'('*'(A,B),A) = '/'(B,'\\'(A,'1'))).
cnf(sos,watchlist,'T'('/'('*'(A,B),'*'(A,C)),A) = '/'(B,C)).
cnf(sos,watchlist,'L'(A,B,'/'(C,B)) ='L'(A,'\\'(B,C),B)).
cnf(sos,watchlist,'L'(A,'\\'(B,C),B) ='L'(A,B,'/'(C,B))).
cnf(sos,watchlist,'T'('L'(A,B,A),B) ='T'(A,'*'(A,B))).
cnf(sos,watchlist,'L'(A,B,C) ='L'(A,C,'/'('*'(C,B),C))).
cnf(sos,watchlist,'L'(A,B,'/'('*'(B,C),B)) ='L'(A,C,B)).
cnf(sos,watchlist,'L'(A,'T'(B,C),C) ='L'(A,C,'/'('*'(B,C),C))).
cnf(sos,watchlist,'L'(A,B,'/'('*'(C,B),B)) ='L'(A,'T'(C,B),B)).
cnf(sos,watchlist,'L'(A,B,C) ='L'(A,'T'(C,B),B)).
cnf(sos,watchlist,'L'(A,'T'(B,C),C) ='L'(A,C,B)).
cnf(sos,watchlist,'*'('*'(A,B),'L'(C,B,A)) = '*'(B,'*'('T'(A,B),C))).
cnf(sos,watchlist,'T'('/'(A,'*'(A,B)),A) = '/'('1',B)).
cnf(sos,watchlist,'T'('/'(A,'*'(B,C)),B) = '/'('\\'(B,A),C)).
cnf(sos,watchlist,'T'('/'('*'(A,B),C),A) = '/'(B,'\\'(A,C))).
cnf(sos,watchlist,'T'('/'(A,B),A) = '/'('1','\\'(A,B))).
cnf(sos,watchlist,'T'('/'(A,B),C) = '/'('\\'(C,A),'\\'(C,B))).
cnf(sos,watchlist,'/'('\\'(A,B),'\\'(A,C)) ='T'('/'(B,C),A)).
cnf(sos,watchlist,'T'(A,B) = '/'(A,'\\'(B,'T'(B,A)))).
cnf(sos,watchlist,'/'(A,'\\'(B,'T'(B,A))) ='T'(A,B)).
cnf(sos,watchlist,'T'(A,B) = '/'('1','\\'(B,'\\'(A,B)))).
cnf(sos,watchlist,'/'('1','\\'(A,'\\'(B,A))) ='T'(B,A)).
cnf(sos,watchlist,'\\'('T'('/'(A,B),A),'1') = '\\'(A,B)).
cnf(sos,watchlist,'\\'('T'(A,B),'1') = '\\'(B,'\\'(A,B))).
cnf(sos,watchlist,'\\'('T'(A,'*'(A,B)),'1') = '\\'('*'(A,B),B)).
cnf(sos,watchlist,'/'('\\'('T'(A,B),C),'\\'(B,'\\'(A,B))) ='T'(C,'T'(A,B))).
cnf(sos,watchlist,'\\'('T'(A,B),A) = '\\'(B,'T'(B,A))).
cnf(sos,watchlist,'T'('/'(A,'T'(A,B)),A) = '/'('1','\\'('T'(B,A),B))).
cnf(sos,watchlist,'*'(A,'*'('T'(B,A),C)) = '*'(B,'*'(A,C))).
cnf(sos,watchlist,'\\'(A,'*'(B,'*'(A,C))) = '*'('T'(B,A),C)).
cnf(sos,watchlist,'*'(A,'*'(B,'T'(B,A))) = '*'(B,'*'(A,B))).
cnf(sos,watchlist,'\\'(A,'*'(B,C)) = '*'('T'(B,A),'\\'(A,C))).
cnf(sos,watchlist,'*'('T'(A,B),'\\'(B,C)) = '\\'(B,'*'(A,C))).
cnf(sos,watchlist,'\\'('T'(A,B),'*'(A,'*'(B,C))) = '*'('T'(B,'T'(A,B)),C)).
cnf(sos,watchlist,~ '*'(A,B) = '*'(C,'*'(A,D)) | B = '*'('T'(C,A),D)).
cnf(sos,watchlist,'*'(A,B) = '*'('T'(A,B),'T'(B,A))).
cnf(sos,watchlist,'*'('T'(A,B),'T'(B,A)) = '*'(A,B)).
cnf(sos,watchlist,'\\'('*'(A,B),'*'(B,'*'(A,B))) ='L'('T'(B,A),B,A)).
cnf(sos,watchlist,'*'(A,'\\'('T'(A,B),C)) = '\\'('T'(A,B),'*'(A,C))).
cnf(sos,watchlist,'\\'('T'(A,B),'*'(A,C)) = '*'(A,'\\'('T'(A,B),C))).
cnf(sos,watchlist,'*'('T'(A,B),'\\'('T'(C,B),'1')) = '\\'(B,'*'(A,'\\'(C,B)))).
cnf(sos,watchlist,'\\'('T'(A,B),'*'(A,B)) ='T'(B,A)).
cnf(sos,watchlist,~ '*'(A,B) = '*'('T'(A,C),D) | B = '*'('T'(A,C),'\\'(A,D))).
cnf(sos,watchlist,A = '*'('T'(B,A),'\\'(B,'T'(A,B)))).
cnf(sos,watchlist,'*'('T'(A,B),'\\'(A,'T'(B,A))) = B).
cnf(sos,watchlist,'T'(A,B) ='T'(A,'T'(B,A))).
cnf(sos,watchlist,'T'(A,'T'(B,A)) ='T'(A,B)).
cnf(sos,watchlist,'\\'('T'(A,B),B) = '\\'(A,'T'(B,A))).
cnf(sos,watchlist,'*'('T'(A,'L'(B,A,B)),'\\'(A,'T'(B,'*'(B,A)))) ='L'(B,A,B)).
cnf(sos,watchlist,'T'(A,'T'(B,'*'(B,A))) ='T'(A,'L'(B,A,B))).
cnf(sos,watchlist,'\\'('T'(A,B),'*'(A,'*'(B,C))) = '*'('T'(B,A),C)).
cnf(sos,watchlist,'*'(A,'\\'('T'(A,B),B)) ='T'(B,A)).
cnf(sos,watchlist,'*'(A,'T'(B,'T'(C,A))) = '*'(C,'*'(A,'\\'('T'('T'(C,A),B),B)))).
cnf(sos,watchlist,'*'(A,'*'(B,'\\'('T'('T'(A,B),C),C))) = '*'(B,'T'(C,'T'(A,B)))).
cnf(sos,watchlist,'\\'('T'(A,B),A) = '*'(A,'\\'('T'(A,B),'1'))).
cnf(sos,watchlist,'*'(A,'\\'('T'(A,B),'1')) = '\\'('T'(A,B),A)).
cnf(sos,watchlist,'\\'('T'(A,B),'*'(A,C)) = '*'('T'(B,A),'\\'(B,C))).
cnf(sos,watchlist,'\\'('T'(A,B),C) = '*'('T'(B,A),'\\'(B,'\\'(A,C)))).
cnf(sos,watchlist,'*'('T'(A,B),'\\'(A,'\\'(B,C))) = '\\'('T'(B,A),C)).
cnf(sos,watchlist,'*'('T'(A,B),'\\'(A,C)) = '*'(B,'\\'('T'(B,A),C))).
cnf(sos,watchlist,'*'(A,'\\'('T'(B,A),C)) = '*'('T'(A,B),'\\'(B,C))).
cnf(sos,watchlist,'*'('T'(A,B),'\\'(B,C)) = '*'(A,'\\'('T'(B,A),C))).
cnf(sos,watchlist,'*'(A,'\\'('T'(B,A),C)) = '\\'(B,'*'(A,C))).
cnf(sos,watchlist,'\\'(A,'\\'(B,'*'(A,C))) = '\\'('T'(B,A),C)).
cnf(sos,watchlist,'*'(A,'\\'('T'('T'(B,A),C),D)) = '\\'('T'(B,C),'*'(A,D))).
cnf(sos,watchlist,'T'('/'('\\'(A,'*'(B,C)),D),B) = '/'('\\'('T'(A,B),C),'\\'(B,D))).
cnf(sos,watchlist,'/'('\\'('T'(A,B),C),'\\'(B,D)) ='T'('/'('\\'(A,'*'(B,C)),D),B)).
cnf(sos,watchlist,'*'(A,'\\'('T'(B,'T'(C,A)),B)) = '\\'(C,'*'(A,'T'('T'(C,A),B)))).
cnf(sos,watchlist,'\\'(A,'*'(B,'T'('T'(A,B),C))) = '*'(B,'\\'('T'(C,'T'(A,B)),C))).
cnf(sos,watchlist,'\\'(A,'*'(B,'\\'(C,'*'(A,D)))) = '*'('T'(B,A),'\\'('T'(C,A),D))).
cnf(sos,watchlist,'\\'(A,'\\'(B,C)) = '\\'('T'(B,A),'\\'(A,C))).
cnf(sos,watchlist,'\\'('T'(A,B),'\\'(B,C)) = '\\'(B,'\\'(A,C))).
cnf(sos,watchlist,'\\'(A,'\\'(B,'*'(C,A))) = '\\'('T'(B,A),'T'(C,A))).
cnf(sos,watchlist,'\\'('T'(A,B),'T'(C,B)) = '\\'(B,'\\'(A,'*'(C,B)))).
cnf(sos,watchlist,'*'(A,'\\'('T'(A,B),'*'(C,B))) = '*'(C,'T'(B,'T'(A,C)))).
