cnf(sos,watchlist,'*'(A,'L'('R'('\\'('\\'(B,A),A),C,D),'\\'(B,A),B)) = '*'(B,'*'('R'(B,C,D),'\\'(B,A)))).
cnf(sos,watchlist,'\\'('\\'(A,B),'*'('*'(A,'T'('\\'(A,B),B)),'\\'(A,B))) = '*'(A,'\\'(A,B))).
cnf(sos,watchlist,'T'('*'(A,'T'('\\'(A,B),B)),'\\'(A,B)) = '*'(A,'\\'(A,B))).
