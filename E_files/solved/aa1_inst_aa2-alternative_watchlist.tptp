cnf(sos,watchlist,'L'(A,'\\'(a(B,'/'('1','T'(C,'*'(A,D))),E),'\\'('*'(B,'*'('/'('1','T'(C,'*'(A,D))),E)),'*'(B,E))),a(B,'/'('1','T'(C,'*'(A,D))),E)) = A).
cnf(sos,watchlist,'L'(A,'*'('\\'(a(B,'/'('1','T'(C,'*'(D,A))),E),'\\'('*'(B,'*'('/'('1','T'(C,'*'(D,A))),E)),'*'(B,E))),D),a(B,'/'('1','T'(C,'*'(D,A))),E)) = A).
cnf(sos,watchlist,'/'('*'(A,'*'(B,C)),'L'(C,B,A)) = '*'(A,B)).
cnf(sos,watchlist,'/'('*'(A,B),'T'(A,B)) = B).
cnf(sos,watchlist,'\\'('R'(A,B,C),'*'('*'(A,B),C)) = '*'(B,C)).
cnf(sos,watchlist,~ '*'(A,B) = '*'(C,A) |'T'(C,A) = B).
cnf(sos,watchlist,'*'(A,'R'('T'(B,A),C,D)) = '*'('R'(B,C,D),A)).
cnf(sos,watchlist,'T'('T'('/'(A,B),C),B) ='T'('\\'(B,A),C)).
cnf(sos,watchlist,'/'(A,'T'(B,'\\'(B,A))) = '\\'(B,A)).
cnf(sos,watchlist,'\\'(A,'*'(A,B)) ='L'(B,A,'1')).
cnf(sos,watchlist,'L'(A,B,'1') = A).
cnf(sos,watchlist,'*'('T'('/'(A,B),C),B) = '*'(B,'T'('\\'(B,A),C))).
