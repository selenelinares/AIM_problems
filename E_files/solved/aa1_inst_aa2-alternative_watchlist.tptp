cnf(sos,watchlist,'*'('*'('*'(A,'*'('/'('1',B),C)),a(A,'/'('1',B),C)),'L'('R'('\\'(a(A,'/'('1',B),C),'\\'('*'(A,'*'('/'('1',B),C)),'*'(A,C))),D,E),a(A,'/'('1',B),C),'*'(A,'*'('/'('1',B),C)))) = '*'('*'(A,'*'('/'('1',B),'R'(B,D,E))),C)).
