cnf(sos,watchlist,'*'('/'('1',A),'T'(A,B)) ='R'('*'('/'('1',A),'T'(A,B)),C,D)).
cnf(sos,watchlist,'R'('*'('/'('1',A),'T'(A,B)),C,D) = '*'('/'('1',A),'T'(A,B))).
cnf(sos,watchlist,'R'('*'('/'('1',A),'T'(A,B)),C,D) = '\\'(A,'T'(A,B))).
cnf(sos,watchlist,'R'('\\'(A,'T'(A,B)),C,D) = '\\'(A,'T'(A,B))).
cnf(sos,watchlist,'L'('\\'(A,'T'(A,B)),'T'(B,A),A) ='R'('\\'('*'(B,A),'*'(A,B)),C,D)).
cnf(sos,watchlist,'R'('\\'('*'(A,B),'*'(B,A)),C,D) ='L'('\\'(B,'T'(B,A)),'T'(A,B),B)).
cnf(sos,watchlist,'K'(A,B) ='R'('\\'('*'(B,A),'*'(A,B)),C,D)).
cnf(sos,watchlist,'R'('\\'('*'(A,B),'*'(B,A)),C,D) ='K'(B,A)).
cnf(sos,watchlist,'R'('K'(A,B),C,D) ='K'(A,B)).
cnf(sos,watchlist,'*'('K'(A,B),'*'(C,D)) = '*'('*'('K'(A,B),C),D)).
cnf(sos,watchlist,'*'('*'('K'(A,B),C),D) = '*'('K'(A,B),'*'(C,D))).
cnf(sos,watchlist,'L'(A,B,'K'(C,D)) = A).
