% *********************************************************
% AIM:  R1-distributivity => aK1
% *********************************************************

% *********************************************************
% S:
% Case 6: R1-distributivity
% R(x1,y,z) * R(x2,y,z) = R(x1 * x2,y,z) # label("R1dist").
% Proof of aK1.
% *********************************************************

% The LADR formulas contain function or predicate symbols
% that are not legal TPTP symbols, and we have replaced those
% symbols with new symbols.  Here is the list of the unaccepted
% symbols and the corresponding replacements.
%
%   (arity 0)        1    '1'
%   (arity 2)        K    'K'
%   (arity 2)        *    '*'
%   (arity 3)        R    'R'
%   (arity 3)        L    'L'
%   (arity 2)        T    'T'
%   (arity 2)        \    '\\'
%   (arity 2)        /    '/'

cnf(sos,axiom,'*'('1',A) = A).
cnf(sos,axiom,'*'(A,'1') = A).
cnf(sos,axiom,'\\'(A,'*'(A,B)) = B).
cnf(sos,axiom,'*'(A,'\\'(A,B)) = B).
cnf(sos,axiom,'/'('*'(A,B),B) = A).
cnf(sos,axiom,'*'('/'(A,B),B) = A).
fof(sos,axiom,! [X0] : ! [X1] : ! [X2] : ! [X3] : (('*'(X0,X1) = X2 & '*'(X0,X3) = X2) => X1 = X3)).
fof(sos,axiom,! [X4] : ! [X5] : ! [X6] : ! [X7] : (('*'(X4,X5) = X6 & '*'(X7,X5) = X6) => X4 = X7)).
fof(sos,axiom,! [X8] : ! [X9] : ! [X10] : ('*'(X8,X9) = '*'(X8,X10) => X9 = X10)).
fof(sos,axiom,! [X11] : ! [X12] : ! [X13] : ('*'(X11,X12) = '*'(X13,X12) => X11 = X13)).
cnf(sos,axiom,~ A = B | '*'(C,A) = '*'(C,B)).
cnf(sos,axiom,~ A = B | '*'(A,C) = '*'(B,C)).
cnf(sos,axiom,'\\'('*'(A,'*'(B,C)),'*'('*'(A,B),C)) = a(A,B,C)).
cnf(sos,axiom,'\\'('*'(A,B),'*'(B,A)) ='K'(B,A)).
cnf(sos,axiom,'\\'('*'(A,B),'*'(A,'*'(B,C))) ='L'(C,B,A)).
cnf(sos,axiom,'/'('*'('*'(A,B),C),'*'(B,C)) ='R'(A,B,C)).
cnf(sos,axiom,'\\'(A,'*'(B,A)) ='T'(B,A)).
fof(sos,axiom,! [X14] : ! [X15] : ! [X16] : (a(X14,X15,X16) ='1' =>'L'(X16,X15,X14) = X16)).
fof(sos,axiom,! [X17] : ! [X18] : ! [X19] : ('L'(X17,X18,X19) = X17 => a(X19,X18,X17) ='1')).
fof(sos,axiom,! [X20] : ! [X21] : ('T'(X20,X21) = X20 =>'T'(X21,X20) = X21)).
fof(sos,axiom,! [X22] : ! [X23] : ('T'(X22,X23) = X22 =>'K'(X22,X23) ='1')).
fof(sos,axiom,! [X24] : ! [X25] : ('K'(X24,X25) ='1' =>'T'(X24,X25) = X24)).
cnf(sos,axiom,'T'('T'(A,B),C) ='T'('T'(A,C),B)).
cnf(sos,axiom,'T'('L'(A,B,C),D) ='L'('T'(A,D),B,C)).
cnf(sos,axiom,'T'('R'(A,B,C),D) ='R'('T'(A,D),B,C)).
cnf(sos,axiom,'L'('R'(A,B,C),D,E) ='R'('L'(A,D,E),B,C)).
cnf(sos,axiom,'L'('L'(A,B,C),D,E) ='L'('L'(A,D,E),B,C)).
cnf(sos,axiom,'R'('R'(A,B,C),D,E) ='R'('R'(A,D,E),B,C)).
cnf(sos,axiom,'*'('R'(A,B,C),'R'(D,B,C)) ='R'('*'(A,D),B,C)).
fof(goals,conjecture,! [X26] : ! [X27] : ! [X28] : ! [X29] : a('K'(X26,X27),X28,X29) ='1').

% *********************************************************
% Original list of hints
% *********************************************************

cnf(sos,watchlist,a('K'(A,B),C,D) ='1').
cnf(sos,watchlist,'*'('1',A) = A).
cnf(sos,watchlist,'*'(A,'1') = A).
cnf(sos,watchlist,'\\'(A,'*'(A,B)) = B).
cnf(sos,watchlist,'*'(A,'\\'(A,B)) = B).
cnf(sos,watchlist,'/'('*'(A,B),B) = A).
cnf(sos,watchlist,'*'('/'(A,B),B) = A).
cnf(sos,watchlist,~ '*'(A,B) = C | ~ '*'(A,D) = C | D = B ).
cnf(sos,watchlist,~ '*'(A,B) = C | ~ '*'(D,B) = C | D = A ).
cnf(sos,watchlist,~ '*'(A,B) = '*'(A,C) | B = C).
cnf(sos,watchlist,~ '*'(A,B) = '*'(C,B) | A = C).
cnf(sos,watchlist,'\\'('*'(A,'*'(B,C)),'*'('*'(A,B),C)) = a(A,B,C)).
cnf(sos,watchlist,a(A,B,C) = '\\'('*'(A,'*'(B,C)),'*'('*'(A,B),C))).
cnf(sos,watchlist,'\\'('*'(A,B),'*'(B,A)) ='K'(B,A)).
cnf(sos,watchlist,'K'(A,B) = '\\'('*'(B,A),'*'(A,B))).
cnf(sos,watchlist,'\\'('*'(A,B),'*'(A,'*'(B,C))) ='L'(C,B,A)).
cnf(sos,watchlist,'L'(A,B,C) = '\\'('*'(C,B),'*'(C,'*'(B,A)))).
cnf(sos,watchlist,'/'('*'('*'(A,B),C),'*'(B,C)) ='R'(A,B,C)).
cnf(sos,watchlist,'R'(A,B,C) = '/'('*'('*'(A,B),C),'*'(B,C))).
cnf(sos,watchlist,'\\'(A,'*'(B,A)) ='T'(B,A)).
cnf(sos,watchlist,'T'(A,B) = '\\'(B,'*'(A,B))).
cnf(sos,watchlist,~'L'(A,B,C) = A | a(C,B,A) ='1').
cnf(sos,watchlist,'T'('T'(A,B),C) ='T'('T'(A,C),B)).
cnf(sos,watchlist,'T'('L'(A,B,C),D) ='L'('T'(A,D),B,C)).
cnf(sos,watchlist,'L'('T'(A,B),C,D) ='T'('L'(A,C,D),B)).
cnf(sos,watchlist,'T'('R'(A,B,C),D) ='R'('T'(A,D),B,C)).
cnf(sos,watchlist,'R'('T'(A,B),C,D) ='T'('R'(A,C,D),B)).
cnf(sos,watchlist,'L'('R'(A,B,C),D,E) ='R'('L'(A,D,E),B,C)).
cnf(sos,watchlist,'*'('R'(A,B,C),'R'(D,B,C)) ='R'('*'(A,D),B,C)).
cnf(sos,watchlist,~ a('K'(c1,c2),c3,c4) ='1').
cnf(sos,watchlist,'\\'('1',A) = A).
cnf(sos,watchlist,'\\'(A,A) ='1').
cnf(sos,watchlist,'/'(A,A) ='1').
cnf(sos,watchlist,'/'(A,'1') = A).
cnf(sos,watchlist,'/'(A,'\\'(B,A)) = B).
cnf(sos,watchlist,'\\'('/'(A,B),A) = B).
cnf(sos,watchlist,~ A = '*'(B,C) | '\\'(B,A) = C).
cnf(sos,watchlist,~ '*'(A,B) = C | '\\'(A,C) = B).
cnf(sos,watchlist,~ '*'(A,'1') = B | A = B).
cnf(sos,watchlist,~ A = '*'(B,C) | '/'(A,C) = B).
cnf(sos,watchlist,~ '*'(A,B) = C | '/'(C,B) = A).
cnf(sos,watchlist,'*'('*'(A,'*'(B,C)),a(A,B,C)) = '*'('*'(A,B),C)).
cnf(sos,watchlist,'*'('*'(A,B),'L'(C,B,A)) = '*'(A,'*'(B,C))).
cnf(sos,watchlist,'L'('\\'(A,B),A,C) = '\\'('*'(C,A),'*'(C,B))).
cnf(sos,watchlist,'L'(A,B,'/'(C,B)) = '\\'(C,'*'('/'(C,B),'*'(B,A)))).
cnf(sos,watchlist,'\\'(A,'*'('/'(A,B),'*'(B,C))) ='L'(C,B,'/'(A,B))).
cnf(sos,watchlist,'R'('1',A,B) = '/'('*'(A,B),'*'(A,B))).
cnf(sos,watchlist,'/'('*'(A,B),'*'(A,B)) ='R'('1',A,B)).
cnf(sos,watchlist,'R'(A,B,'1') = '/'('*'(A,B),'*'(B,'1'))).
cnf(sos,watchlist,'/'('*'(A,B),'*'(B,'1')) ='R'(A,B,'1')).
cnf(sos,watchlist,'R'(A,'\\'(A,B),C) = '/'('*'(B,C),'*'('\\'(A,B),C))).
cnf(sos,watchlist,'R'(A,B,'\\'(B,C)) = '/'('*'('*'(A,B),'\\'(B,C)),C)).
cnf(sos,watchlist,'/'('*'('*'(A,B),'\\'(B,C)),C) ='R'(A,B,'\\'(B,C))).
cnf(sos,watchlist,'*'('R'(A,B,C),'*'(B,C)) = '*'('*'(A,B),C)).
cnf(sos,watchlist,'R'('/'(A,B),B,C) = '/'('*'(A,C),'*'(B,C))).
cnf(sos,watchlist,'R'(A,'/'(B,C),C) = '/'('*'('*'(A,'/'(B,C)),C),B)).
cnf(sos,watchlist,'/'('*'('*'(A,'/'(B,C)),C),B) ='R'(A,'/'(B,C),C)).
cnf(sos,watchlist,'*'(A,'T'(B,A)) = '*'(B,A)).
cnf(sos,watchlist,'T'('/'(A,B),B) = '\\'(B,A)).
cnf(sos,watchlist,~ '*'(A,B) = C | A = '/'(C,B)).
cnf(sos,watchlist,'R'(A,B,C) = '/'('R'('*'(A,D),B,C),'R'(D,B,C))).
cnf(sos,watchlist,'/'('R'('*'(A,B),C,D),'R'(B,C,D)) ='R'(A,C,D)).
cnf(sos,watchlist,~ '*'(A,B) = C | B = '\\'(A,C)).
cnf(sos,watchlist,'R'(A,B,C) = '\\'('R'(D,B,C),'R'('*'(D,A),B,C))).
cnf(sos,watchlist,'\\'('R'(A,B,C),'R'('*'(A,D),B,C)) ='R'(D,B,C)).
cnf(sos,watchlist,'/'('*'(A,B),'T'(A,B)) = B).
cnf(sos,watchlist,'\\'('R'(A,B,C),'*'('*'(A,B),C)) = '*'(B,C)).
cnf(sos,watchlist,'R'(A,B,'T'(C,B)) = '/'('*'('*'(A,B),'T'(C,B)),'*'(C,B))).
cnf(sos,watchlist,'/'('*'('*'(A,B),'T'(C,B)),'*'(C,B)) ='R'(A,B,'T'(C,B))).
cnf(sos,watchlist,'T'(A,'T'(B,A)) = '\\'('T'(B,A),'*'(B,A))).
cnf(sos,watchlist,'\\'('T'(A,B),'*'(A,B)) ='T'(B,'T'(A,B))).
cnf(sos,watchlist,'*'(A,'T'('T'(B,A),C)) = '*'('T'(B,C),A)).
cnf(sos,watchlist,'*'(A,'R'('T'(B,A),C,D)) = '*'('R'(B,C,D),A)).
cnf(sos,watchlist,'R'('1',A,B) ='1').
cnf(sos,watchlist,'/'('*'(A,B),B) ='R'(A,B,'1')).
cnf(sos,watchlist,'R'(A,B,'1') = A).
cnf(sos,watchlist,'*'(A,'T'('\\'(A,B),C)) = '*'('T'('/'(B,A),C),A)).
cnf(sos,watchlist,'*'('T'('/'(A,B),C),B) = '*'(B,'T'('\\'(B,A),C))).
cnf(sos,watchlist,~ '*'(A,'*'(B,C)) = '*'('*'(A,B),D) |'L'(C,B,A) = D).
cnf(sos,watchlist,~ '*'('*'(A,B),C) = '*'(A,'*'(B,D)) |'L'(D,B,A) = C).
cnf(sos,watchlist,'T'(A,'*'(A,B)) ='L'('\\'(B,'*'(A,B)),B,A)).
cnf(sos,watchlist,'L'('\\'(A,'*'(B,A)),A,B) ='T'(B,'*'(B,A))).
cnf(sos,watchlist,'L'('\\'('T'(A,B),C),'T'(A,B),B) = '\\'('*'(A,B),'*'(B,C))).
cnf(sos,watchlist,'*'('R'(A,'/'(B,C),C),B) = '*'('*'(A,'/'(B,C)),C)).
cnf(sos,watchlist,a('R'(A,B,C),B,C) = '\\'('*'('*'(A,B),C),'*'('*'('R'(A,B,C),B),C))).
cnf(sos,watchlist,'\\'('*'('*'(A,B),C),'*'('*'('R'(A,B,C),B),C)) = a('R'(A,B,C),B,C)).
cnf(sos,watchlist,'R'('/'('1',A),A,B) = '/'(B,'*'(A,B))).
cnf(sos,watchlist,'R'('/'(A,B),B,'\\'(B,C)) = '/'('*'(A,'\\'(B,C)),C)).
cnf(sos,watchlist,'R'('/'('/'(A,B),C),C,B) = '/'(A,'*'(C,B))).
cnf(sos,watchlist,'R'('T'('/'(A,B),C),B,D) ='T'('/'('*'(A,D),'*'(B,D)),C)).
cnf(sos,watchlist,'T'('/'('*'(A,B),'*'(C,B)),D) ='R'('T'('/'(A,C),D),C,B)).
cnf(sos,watchlist,'R'('/'('1',A),A,'\\'(A,B)) = '/'('\\'(A,B),B)).
cnf(sos,watchlist,'R'('T'('/'('1',A),B),A,C) ='T'('/'(C,'*'(A,C)),B)).
cnf(sos,watchlist,'T'('/'(A,'*'(B,A)),C) ='R'('T'('/'('1',B),C),B,A)).
cnf(sos,watchlist,'\\'('R'('/'('1',A),A,B),B) = '*'(A,B)).
cnf(sos,watchlist,'\\'('R'(A,'\\'(A,'1'),B),B) = '*'('\\'(A,'1'),B)).
cnf(sos,watchlist,'L'('T'(A,B),B,A) ='T'(A,'*'(A,B))).
cnf(sos,watchlist,'L'('T'('T'(A,B),C),B,A) ='T'('T'(A,'*'(A,B)),C)).
cnf(sos,watchlist,'R'('T'('/'('/'(A,B),C),D),C,B) ='T'('/'(A,'*'(C,B)),D)).
cnf(sos,watchlist,'*'('/'(A,'*'(B,C)),'R'(D,B,C)) ='R'('*'('/'('/'(A,C),B),D),B,C)).
cnf(sos,watchlist,'R'('*'('/'('/'(A,B),C),D),C,B) = '*'('/'(A,'*'(C,B)),'R'(D,C,B))).
cnf(sos,watchlist,'R'(A,'\\'(A,'/'(B,C)),C) = '/'(B,'*'('\\'(A,'/'(B,C)),C))).
cnf(sos,watchlist,'R'('/'('1',A),A,'\\'(A,'1')) = '\\'(A,'1')).
cnf(sos,watchlist,'*'('R'(A,B,'\\'(B,'1')),'\\'(B,'1')) ='R'('*'(A,'/'('1',B)),B,'\\'(B,'1'))).
cnf(sos,watchlist,'R'('*'(A,'/'('1',B)),B,'\\'(B,'1')) = '*'('R'(A,B,'\\'(B,'1')),'\\'(B,'1'))).
cnf(sos,watchlist,'*'(A,'R'('\\'(A,B),C,D)) = '*'('R'('/'(B,A),C,D),A)).
cnf(sos,watchlist,'*'('R'('/'(A,B),C,D),B) = '*'(B,'R'('\\'(B,A),C,D))).
cnf(sos,watchlist,'/'('*'(A,'T'('\\'(A,B),C)),A) ='T'('/'(B,A),C)).
cnf(sos,watchlist,'/'('*'(A,'T'(B,C)),A) ='T'('/'('*'(A,B),A),C)).
cnf(sos,watchlist,'\\'('R'(A,'*'(B,C),a(A,B,C)),'*'('*'(A,B),C)) = '*'('*'(B,C),a(A,B,C))).
cnf(sos,watchlist,'L'(A,B,'/'('1',B)) = '*'('/'('1',B),'*'(B,A))).
cnf(sos,watchlist,'*'('/'('1',A),'*'(A,B)) ='L'(B,A,'/'('1',A))).
cnf(sos,watchlist,'*'('/'('1',A),'*'(B,A)) ='L'('T'(B,A),A,'/'('1',A))).
cnf(sos,watchlist,'L'('T'(A,B),B,'/'('1',B)) = '*'('/'('1',B),'*'(A,B))).
cnf(sos,watchlist,'*'('/'('1',A),'*'('R'(B,C,D),A)) ='L'('R'('T'(B,A),C,D),A,'/'('1',A))).
cnf(sos,watchlist,'L'('R'('T'(A,B),C,D),B,'/'('1',B)) = '*'('/'('1',B),'*'('R'(A,C,D),B))).
cnf(sos,watchlist,'R'(A,B,'\\'(B,'1')) = '*'('*'(A,B),'\\'(B,'1'))).
cnf(sos,watchlist,'*'('*'(A,B),'\\'(B,'1')) ='R'(A,B,'\\'(B,'1'))).
cnf(sos,watchlist,'/'('R'(A,B,'\\'(B,'1')),'\\'(B,'1')) = '*'(A,B)).
cnf(sos,watchlist,~'R'(A,B,'\\'(B,'1')) = '*'(C,'\\'(B,'1')) | '*'(A,B) = C).
cnf(sos,watchlist,'R'(A,'/'('1',B),B) = '*'('*'(A,'/'('1',B)),B)).
cnf(sos,watchlist,'*'('*'(A,'/'('1',B)),B) ='R'(A,'/'('1',B),B)).
cnf(sos,watchlist,'/'('R'(A,'/'('1',B),B),B) = '*'(A,'/'('1',B))).
cnf(sos,watchlist,'/'('R'(A,B,C),'R'(D,B,C)) ='R'('/'(A,D),B,C)).
cnf(sos,watchlist,'\\'('R'(A,B,C),'R'(D,B,C)) ='R'('\\'(A,D),B,C)).
cnf(sos,watchlist,'T'('R'('/'(A,B),B,'\\'(B,C)),C) = '\\'(C,'*'(A,'\\'(B,C)))).
cnf(sos,watchlist,'/'('T'('/'(A,'*'('/'('1',A),A)),B),A) = '*'('T'('/'('1','/'('1',A)),B),'/'('1',A))).
cnf(sos,watchlist,'*'('*'(A,B),'T'('T'(A,'*'(A,B)),C)) = '*'(A,'*'(B,'T'('T'(A,B),C)))).
cnf(sos,watchlist,'L'('R'('T'(A,B),C,D),B,'/'('1',B)) ='R'('*'('/'('1',B),'*'(A,B)),C,D)).
cnf(sos,watchlist,'/'('1','R'(A,B,C)) ='R'('/'('1',A),B,C)).
cnf(sos,watchlist,'R'('/'('1',A),B,C) = '/'('1','R'(A,B,C))).
cnf(sos,watchlist,'\\'('R'('/'('1',A),B,C),'1') ='R'(A,B,C)).
cnf(sos,watchlist,'\\'('\\'(A,'1'),'1') ='R'(A,A,'\\'(A,'1'))).
cnf(sos,watchlist,'R'(A,A,'\\'(A,'1')) = '\\'('\\'(A,'1'),'1')).
cnf(sos,watchlist,'/'('*'(A,'R'('\\'(A,B),C,D)),A) ='R'('/'(B,A),C,D)).
cnf(sos,watchlist,'/'('*'(A,'R'(B,C,D)),A) ='R'('/'('*'(A,B),A),C,D)).
cnf(sos,watchlist,'R'('/'('*'(A,B),A),C,D) = '/'('*'(A,'R'(B,C,D)),A)).
cnf(sos,watchlist,'R'('/'('*'(A,B),A),B,'\\'(B,'1')) = '/'('*'(A,'\\'('\\'(B,'1'),'1')),A)).
cnf(sos,watchlist,'R'(A,B,'T'(A,B)) ='T'('/'('*'('*'(A,B),A),'*'(A,B)),B)).
cnf(sos,watchlist,'T'('/'('*'('*'(A,B),A),'*'(A,B)),B) ='R'(A,B,'T'(A,B))).
cnf(sos,watchlist,'L'('R'('\\'('T'(A,B),C),D,E),'T'(A,B),B) ='R'('\\'('*'(A,B),'*'(B,C)),D,E)).
cnf(sos,watchlist,'T'('/'('*'(A,B),'*'(C,B)),C) ='R'('\\'(C,A),C,B)).
cnf(sos,watchlist,'T'('/'(A,'*'(B,C)),B) ='R'('\\'(B,'/'(A,C)),B,C)).
cnf(sos,watchlist,'R'('\\'(A,'/'(B,C)),A,C) ='T'('/'(B,'*'(A,C)),A)).
cnf(sos,watchlist,'R'('T'('/'(A,B),C),B,'\\'(B,C)) = '\\'(C,'*'(A,'\\'(B,C)))).
cnf(sos,watchlist,'R'('T'('/'(A,B),A),B,'\\'(B,A)) = '\\'(B,A)).
cnf(sos,watchlist,'R'('T'('/'(A,'/'(A,B)),A),'/'(A,B),'\\'('/'(A,B),A)) = B).
cnf(sos,watchlist,'R'('T'('/'(A,'/'(A,B)),A),'/'(A,B),B) = B).
cnf(sos,watchlist,'*'(A,B) = '*'('*'('T'('/'(B,'/'(B,A)),B),'/'(B,A)),A)).
cnf(sos,watchlist,'*'('*'('T'('/'(A,'/'(A,B)),A),'/'(A,B)),B) = '*'(B,A)).
cnf(sos,watchlist,'*'('*'('/'(A,B),'T'('\\'('/'(A,B),A),A)),B) = '*'(B,A)).
cnf(sos,watchlist,'*'('*'('/'(A,B),'T'(B,A)),B) = '*'(B,A)).
cnf(sos,watchlist,'/'('*'(A,B),A) = '*'('/'(B,A),'T'(A,B))).
cnf(sos,watchlist,'*'('/'(A,B),'T'(B,A)) = '/'('*'(B,A),B)).
cnf(sos,watchlist,'/'('/'('*'(A,B),A),'T'(A,B)) = '/'(B,A)).
cnf(sos,watchlist,'\\'('/'(A,B),'/'('*'(B,A),B)) ='T'(B,A)).
cnf(sos,watchlist,'T'(A,B) = '\\'('/'(B,A),'/'('*'(A,B),A))).
cnf(sos,watchlist,'T'('/'(A,B),'T'(B,A)) = '\\'('T'(B,A),'/'('*'(B,A),B))).
cnf(sos,watchlist,'\\'('T'(A,B),'/'('*'(A,B),A)) ='T'('/'(B,A),'T'(A,B))).
cnf(sos,watchlist,'/'('/'('*'(A,B),B),'T'(B,'T'(A,B))) = '/'('T'(A,B),B)).
cnf(sos,watchlist,'T'(A,'*'(B,A)) = '\\'(B,'/'('*'(A,'*'(B,A)),A))).
