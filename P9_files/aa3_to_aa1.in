a(x,y,z / (u \ w)) = a(x,y,(z / w) * u).
a(x,y,(z / u) * w) = a(x,y,z / (w \ u)).
a(x,y,z / ((1 / u) * w)) = a(x,y,z / (u \ w)).
a(x,y,z / L(u,w,v5)) = a(x,y,z / u).
a(x,y,z / u) = a(x,y,z / L(u,w,v5)).
a(x,y,(z \ u) * z) = a(x,y,T(u,z)).
a(x,y,T(z,u)) = a(x,y,(u \ z) * u).
