L(L(K(x,a(y,z,u)),x,w),w * x,v5) = K(L(x,w,v5),a(y,z,u)).
(x * (y * z)) \ (x * (y * T(z,a(u,w,v5)))) = K(L(z,y,x),a(u,w,v5)).
L(K(L(x,y,z),a(u,w,v5)),L(x,y,z),z * y) = (z * (y * x)) \ (z * (y * T(x,a(u,w,v5)))).
(x * (y * z)) \ (x * (y * T(z,a(u,w,v5)))) = L(K(L(z,y,x),a(u,w,v5)),L(z,y,x),x * y).
L(R(a(x,y,z),L(z,y,x),z \ u),w,v5) = L((u * a(x,y,T(z,u))) / u,w,v5).
(x * y) * (z / a(u,w,T(x,y * z))) = (L(x,w,u) * y) * z.
