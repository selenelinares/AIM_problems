% ****************
% AIM:  aa3 => aa1
% ****************

assign(order,kbo).
set(lex_order_vars).

set(para_from_small).

clear(back_demod).
set(restrict_denials).

assign(max_weight,5).

formulas(assumptions).

   % loop axioms
   1 * x = x.
   x * 1 = x.
   x \ (x * y) = y.
   x * (x \ y) = y.
   (x * y) / y = x.
   (x / y) * y = x.

   % cancellation laws
   x * y = u & x * z = u -> y = z.
   y * x = u & z * x = u -> y = z.

      % other form
      x * y = x * z -> y = z.
      y * x = z * x -> y = z.

   % associator (right associated * a = left associated)
   (x * (y * z)) \ ((x * y) * z) = a(x,y,z) # label("associator").

   % commutator ( (x * y) * K(y,x) = y * x )
   (x * y) \ (y * x) = K(y,x) # label("commutator").

   % inner mappings
   (y * x) \ (y * (x * u)) = L(u,x,y).
   ((u * x) * y) / (x * y) = R(u,x,y).
   x \ (u * x) = T(u,x).

   % obvious compatibility
   a(x,y,z) = 1 -> L(z,y,x) = z.
   L(x,y,z) = x -> a(z,y,x) = 1.
   T(x,y) = x -> T(y,x) = y.
   T(x,y) = x -> K(x,y) = 1.
   K(x,y) = 1 -> T(x,y) = x.

   % abelian inner mapping group
   T(T(u,x),y) = T(T(u,y),x).
   T(L(u,x,y),z) = L(T(u,z),x,y).
   T(R(u,x,y),z) = R(T(u,z),x,y).
   L(R(u,x,y),z,w) = R(L(u,z,w),x,y).
   L(L(u,x,y),z,w) = L(L(u,z,w),x,y).
   R(R(u,x,y),z,w) = R(R(u,z,w),x,y).

end_of_list.

formulas(assumptions).

   a(x,y,a(z,u,w)) = 1            # label("aa3").

end_of_list.

formulas(goals).

   a(a(x,y,z),u,w) = 1            # label("aa1").

end_of_list.

%
% Hints extracted from previously found proofs.
%

formulas(hints).

L(x,y,a(z,u,w)) = x.
L(x,y * z,a(u,w,y)) = x.
L(x,y * z,R(a(u,w,y),y,z)) = x.
L(x,y * z,R(a(u,w,y),y,z)) = (y * z) \ ((y * z) * x).
(x * y) \ ((x * y) * z) = L(z,x * y,R(a(u,w,x),x,y)).
(L(x,y,z) * (a(z,y,x) * u)) \ ((x * u) * w) = L(w,x * u,R(a(z,y,x),x,u)).
L(x,y * z,R(a(u,w,y),y,z)) = (L(y,w,u) * (a(u,w,y) * z)) \ ((y * z) * x).
(x * (a(y,z,x) * u)) \ (a(y,z,x) * ((x * u) * w)) = L(w,x * u,R(a(y,z,x),x,u)).
R(a(x,y,z),z,u) = a(x,y,z).
R(a(x,y,z),z,z \ u) = a(x,y,z).
R(a(x,y,z),z,z \ u) = L(a(x,y,z),w,v5).
R(a(x,y,z),z,z \ u) = L(u / (a(x,y,z) \ u),w,v5).
R(a(x,y,z),z,z \ u) = L(u / (u / a(x,y,T(z,u))),w,v5).
R(a(x,y,z),z,z \ u) = L((u * a(x,y,T(z,u))) / u,w,v5).
L((x * a(y,z,T(u,x))) / x,w,v5) = R(a(y,z,u),u,u \ x).
L(R(a(x,y,z),z,z \ u),w,v5) = L((u * a(x,y,T(z,u))) / u,w,v5).
R(a(x,y,z),L(z,y,x),u) = R(a(x,y,z),z,u).
R(a(x,y,z),L(z,y,x),u) = L(R(a(x,y,z),z,u),w,v5).
(x * y) / (L(x,z,u) * y) = R(a(u,z,x),x,y).
(L(x,y,z) * u) \ T(x * u,(x * u) / (L(x,y,z) * u)) = (x * u) / (L(x,y,z) * u).
(x * y) \ (a(z,u,x) * w) = (L(x,u,z) * y) \ w.
(x * (a(y,z,x) * u)) \ (R(a(y,z,x),x,u) * ((x * u) * w)) = L(w,x * u,R(a(y,z,x),x,u)).
L(x,y,z) * (a(z,y,x) * u) = x * u.
(x * a(y,z,x)) * u = x * (a(y,z,x) * u).
L(x,a(y,z,u),u) = x.
L(x \ (L(y,z,u) \ w),x,y) = (y * x) \ (a(u,z,y) * w).
a(x,y,z) * (a(x,y,z) \ u) = L(u,a(x,y,z),z).
L(x,y,z) * (x \ u) = a(z,y,x) \ u.
a(x,y,z) \ u = L(z,y,x) * (z \ u).
x / a(y,z,T(u,x)) = a(y,z,u) \ x.
(x \ y) * a(z,u,T(w,y)) = x \ (a(z,u,w) * y).
a(x,y,T(z,u)) = T(a(x,y,z),u).
T(a(x,y,z),u) = a(x,y,T(z,u)).
T(a(x,y,z),L(u,w,v5)) = T(a(x,y,z),u).
(x * (y * (a(z,u,w) \ v5))) \ (x * (y * v5)) = T(a(z,u,w),L(v5,y,x)).
((x * y) * L(a(z,u,w) \ v5,y,x)) \ (x * (y * v5)) = T(a(z,u,w),L(v5,y,x)).
