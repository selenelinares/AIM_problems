R(T(x,y),z,u) = T(R(x,z,u),y).
T(R(x,y,z),u) = R(T(x,u),y,z).
L(T(x,y),z,u) = T(L(x,z,u),y).
T(L(x,y,z),u) = L(T(x,u),y,z).
T(T(x,y),z) = T(T(x,z),y).
K(x,y) != 1 | T(x,y) = x.
T(x,y) != x | K(x,y) = 1.
T(x,y) != x | T(y,x) = y.
L(x,y,z) != x | a(z,y,x) = 1.
a(x,y,z) != 1 | L(z,y,x) = z.
T(x,y) = y \ (x * y).
x \ (y * x) = T(y,x).
R(x,y,z) = ((x * y) * z) / (y * z).
((x * y) * z) / (y * z) = R(x,y,z).
L(x,y,z) = (z * y) \ (z * (y * x)).
(x * y) \ (x * (y * z)) = L(z,y,x).
K(x,y) = (y * x) \ (x * y).
(x * y) \ (y * x) = K(y,x).
a(x,y,z) = (x * (y * z)) \ ((x * y) * z).
(x * (y * z)) \ ((x * y) * z) = a(x,y,z).
x * y != z * y | x = z.
x * y != x * z | y = z.
x * y != z | u * y != z | u = x.
x * y != z | x * u != z | u = y.
(x / y) * y = x.
(x * y) / y = x.
x * (x \ y) = y.
x \ (x * y) = y.
x * 1 = x.
1 * x = x.
a(K(x,y),z,u) = 1.

end_of_list.
