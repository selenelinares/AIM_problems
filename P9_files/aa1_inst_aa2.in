L(x,y,z) != x | a(z,y,x) = 1.
a(x,y,z) != 1 | L(z,y,x) = z.
T(x,y) = y \ (x * y).
x \ (y * x) = T(y,x).
R(x,y,z) = ((x * y) * z) / (y * z).
((x * y) * z) / (y * z) = R(x,y,z).
L(x,y,z) = (z * y) \ (z * (y * x)).
(x * y) \ (x * (y * z)) = L(z,y,x).
a(x,y,z) = (x * (y * z)) \ ((x * y) * z).
(x * (y * z)) \ ((x * y) * z) = a(x,y,z).
x * y != z * y | x = z.
x * y != x * z | y = z.
x * y != z | u * y != z | u = x.
(x / y) * y = x.
(x * y) / y = x.
x * (x \ y) = y.
x \ (x * y) = y.
x * 1 = x.
1 * x = x.
a(x,a(y,z,u),w) = 1.

end_of_list.
