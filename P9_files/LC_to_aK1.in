% *********************************************************
% AIM:  LC => aK1
% *********************************************************

assign(order,kbo).
set(lex_order_vars).

set(para_from_small).

clear(back_demod).
set(restrict_denials).

assign(max_weight,5).

formulas(assumptions).

   % loop axioms
   1 * x = x. %ax1
   x * 1 = x. %ax2
   x \ (x * y) = y. %ax3
   x * (x \ y) = y. %ax4
   (x * y) / y = x. %ax5
   (x / y) * y = x. %ax6

   % cancellation laws
   x * y = u & x * z = u -> y = z. %ax7
   y * x = u & z * x = u -> y = z. %ax8

      % other form
      x * y = x * z -> y = z. %ax9
      y * x = z * x -> y = z. %ax10

   % useful in demodulation free runs
   x != y | z * x = z * y. %ax11
   x != y | x * z = y * z. %ax12

   % associator (right associated * a = left associated)
   (x * (y * z)) \ ((x * y) * z) = a(x,y,z) # label("associator"). %ax13

   % commutator ( (x * y) * K(y,x) = y * x )
   (x * y) \ (y * x) = K(y,x) # label("commutator"). %ax14

   % inner mappings
   (y * x) \ (y * (x * u)) = L(u,x,y). %ax15
   ((u * x) * y) / (x * y) = R(u,x,y). %ax16
   x \ (u * x) = T(u,x).

   % obvious compatibility
   a(x,y,z) = 1 -> L(z,y,x) = z. %ax17
   L(x,y,z) = x -> a(z,y,x) = 1. %ax18
   T(x,y) = x -> T(y,x) = y. %ax19
   T(x,y) = x -> K(x,y) = 1. %ax20
   K(x,y) = 1 -> T(x,y) = x. %ax21

   % abelian inner mapping group
   T(T(u,x),y) = T(T(u,y),x). %ax22
   T(L(u,x,y),z) = L(T(u,z),x,y). %ax23
   T(R(u,x,y),z) = R(T(u,z),x,y). %ax24
   L(R(u,x,y),z,w) = R(L(u,z,w),x,y). %ax25
   L(L(u,x,y),z,w) = L(L(u,z,w),x,y). %ax26
   R(R(u,x,y),z,w) = R(R(u,z,w),x,y). %ax27

   % ------------
   % Special Case
   % ------------

   (x * (x * y)) * z = x * (x * (y * z)) # label("LC"). %ax28

end_of_list.

formulas(goals).

   a(K(x,y),z,u) = 1 # label("aK1").

end_of_list.

