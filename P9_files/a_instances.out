9 K(x,y) = 1 -> T(x,y) = x # label(non_clause).  [assumption].
18 a(w,K(x,y),w) = 1 # label("aK2{x1/x4}") # label(non_clause) # label(goal).  [goal].
34 1 * x = x.  [assumption].
35 x * 1 = x.  [assumption].
36 x \ (x * y) = y.  [assumption].
37 x * (x \ y) = y.  [assumption].
